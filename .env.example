# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Paid-report AI settings (all optional; defaults in app/ai/config.py)
# REPORT_MODEL=claude-opus-5        # claude-sonnet-5 is ~60% cheaper per report
# REPORT_EFFORT=medium              # low | medium | high | xhigh | max
# REPORT_MAX_ATTEMPTS=2             # 1 generation + regenerations when safety/fact checks fail
# REPORTS_UNLOCKED=0                # 1 = POST /api/report open WITHOUT payment. Dev/test only!
# Report PDFs (app/pdf; all optional - see docs/API.md "Report PDFs")
# PDF_CHROMIUM_EXECUTABLE=/usr/bin/chromium   # default: Playwright's own chromium-headless-shell
# PDF_CHROMIUM_LD_LIBRARY_PATH=               # extra lib dirs for Chromium on a box without root; empty = none
# PDF_CHROMIUM_ARGS=                          # extra Chromium flags
# PDF_TIMEOUT_SECONDS=60
# PDF_MAX_CONCURRENT=1                        # Chromium processes allowed at once
# PDFS_DIR=var/pdfs
# Razorpay (docs/PAYMENTS.md). Without the two keys the buy buttons show "launching soon".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # the secret typed into the Razorpay webhook form; any long random string
BASE_URL=http://localhost:8000

# AI consultation chat (all optional; defaults in app/ai/config.py)
# SESSION_SECRET=                   # REQUIRED in production: signs the user-id cookie (any long random string)
# CHAT_MODEL=claude-opus-5          # claude-sonnet-5 is ~60% cheaper per message
# CHAT_EFFORT=low
# CHAT_FREE_MESSAGES=2
# CHAT_FREE_PER_IP_PER_DAY=10       # cap on free AI replies per network per day
# CHAT_RATE_PER_MINUTE=6
# TRUST_PROXY=0                     # 1 only behind your own reverse proxy (uses X-Forwarded-For)
# APP_DB=var/app.db

# Rashifal batch job (all optional; defaults in app/rashifal/config.py, docs/API.md "Rashifal")
# RASHIFAL_MODEL=claude-haiku-4-5   # all languages unless overridden below
# RASHIFAL_MODEL_MR=claude-sonnet-5 # per-language override (also _EN, _HI): better Marathi for ~Rs 600/month more
# RASHIFAL_SPLIT_LANGUAGES=1        # one call per language: written in that language, not translated
# RASHIFAL_BATCH=1                  # Message Batches API for runs of 4+ jobs: 50% cheaper, asynchronous
# RASHIFAL_LANGUAGES=en,hi,mr       # all required for a page to be complete
# RASHIFAL_SCHEDULER=0              # 1 = in-process APScheduler; production uses deploy/systemd/rashifal-refresh.timer

# ---- the order-link e-mail (app/mailer.py) -------------------------------------------------------
# One message per purchase: the permanent link to the order. OFF unless REPORT_EMAIL_ENABLED is set,
# so a key alone can never start sending. EMAIL_FROM's domain must be the one verified with Resend.
REPORT_EMAIL_ENABLED=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ---- the admin dashboard (/admin, app/admin) -----------------------------------------------------
# ADMIN_PASSWORD is REQUIRED to open /admin. Unset, every request there answers 401 - which is the safe
# default and not a bug, but it does mean a deploy with this blank ships a dashboard nobody can open.
# Use a long random value: `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
ADMIN_PASSWORD=
ADMIN_USER=admin
# Alerts and the 9:00 IST digest. Both need Resend configured above; ALERT_EMAIL_TO defaults to the
# support address. NEITHER SENDS UNTIL CRON CALLS IT - see deploy/README-DEPLOY.md for the two lines.
ALERT_EMAIL_TO=
AI_DAILY_LIMIT_INR=300
ALERT_COST_LIMIT_BOOK_INR=150
ALERT_COST_LIMIT_REPORT_INR=40

# ---- GST (app/payments/gst.py) --------------------------------------------------------------------
# The listed prices in app/payments/catalogue.py INCLUDE GST: ₹59 is charged as ₹59, and the tax inside it
# is taken out for the invoice. The code default matches the catalogue on purpose - if it did not, a missing
# line here would silently charge ₹69.62 for the ₹59 product instead of failing.
GST_RATE_PERCENT=18
GST_INCLUSIVE=1
INVOICE_PREFIX=RK
INVOICE_SAC=998439
