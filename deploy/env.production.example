# Production environment for /srv/astrology/.env   (chmod 600, owner astro). Every variable the app reads is listed.
# REQUIRED = the app refuses to start without it when APP_ENV=production (app/hardening.py), or a feature is dead.
# Check what is still wrong at any time:   .venv/bin/python -m app.hardening

# ---- mode ------------------------------------------------------------------------------------------------
APP_ENV=production                 # REQUIRED. Turns the config check into a hard stop and hides /docs
BASE_URL=https://rashikundli.com   # REQUIRED, https, apex (www redirects here), no trailing slash: canonicals, sitemap, hreflang, Secure cookie, HSTS
SESSION_SECRET=                    # REQUIRED. python3 -c "import secrets; print(secrets.token_urlsafe(48))"  - never change it later
TRUST_PROXY=1                      # REQUIRED behind nginx: per-visitor rate limits use X-Forwarded-For
# CSP_MODE=enforce                 # enforce | report-only | off  (report-only is the escape hatch if Razorpay's popup is blocked)
# REPORTS_UNLOCKED                 # NEVER set in production (dev switch that makes paid reports free; the app refuses to start)

# ---- brand + legal entity (brand decided: RashiKundli / rashikundli.com; the entity details are still to come) -----
SITE_NAME=RashiKundli
# SITE_TAGLINE=Accurate Vedic astrology, calculated with Swiss Ephemeris
# These have real defaults in app/web/site.py; set them here only to change them without a code edit.
LEGAL_ENTITY=                      # default: Ketan Pujari, sole proprietor, trading as RashiKundli AI
LEGAL_ADDRESS=                     # default: E504, Greenlands Society, Pimple Saudagar, Pune, Maharashtra - 411027, India
SUPPORT_EMAIL=                     # default: support@rashikundli.com (a mailbox of THIS venture only)
SUPPORT_PHONE=                     # EMPTY = e-mail support only, and the pages say so. Set a number to show one
GSTIN=                             # default: 27CPNPP5754C2ZI (printed on /contact, /terms and /about)
LEGAL_JURISDICTION=                # default: Pune, India
SOURCE_URL=                        # REQUIRED while we ship under the AGPL: the public source repository
                                   # offered on /about (AGPL section 13). See LICENSE in the repo root.
POLICIES_UPDATED=21 September 2026   # "Last updated" date printed on the policy pages

# ---- AI (Anthropic) --------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=                 # REQUIRED for paid reports, consultation and rashifal refresh (free tools work without it)
# ANTHROPIC_AUTH_TOKEN=            # alternative credential the SDK accepts
# Models (decided): Sonnet 5 for paid reports + consultation, Haiku 4.5 through the Batch API for rashifal. USD per
# million tokens (app/ai/config.py): claude-opus-5 5 in / 25 out · claude-sonnet-5 2 / 10 · claude-haiku-4-5 1 / 5
REPORT_MODEL=claude-sonnet-5
# REPORT_EFFORT=medium             # low | medium | high | xhigh | max
# REPORT_MAX_TOKENS=32000
# REPORT_MAX_ATTEMPTS=2            # 1 generation + regenerations when the safety / fact checks fail
# REPORT_FALLBACKS=default         # default | off
# REPORT_TIMEOUT_SECONDS=300
# REPORT_API_RETRIES=3
CHAT_MODEL=claude-sonnet-5
# CHAT_EFFORT=low
# CHAT_MAX_TOKENS=4000
# CHAT_FREE_MESSAGES=2
# CHAT_PACK_MESSAGES=10
# CHAT_PACK_PRICE_INR=99           # consultation: 10 questions + the Kundali PDF (report prices ₹49 / ₹99: app/payments/catalogue.py)
# CHAT_RATE_PER_MINUTE=6
# CHAT_FREE_PER_IP_PER_DAY=10
RASHIFAL_MODEL=claude-haiku-4-5
# RASHIFAL_EFFORT=low
# RASHIFAL_MAX_TOKENS=16000
# RASHIFAL_MAX_ATTEMPTS=2
# RASHIFAL_LANGUAGES=en,mr,hi
RASHIFAL_BATCH=1                   # Message Batches API: 50% cheaper, asynchronous (minutes to an hour)
# RASHIFAL_BATCH_TIMEOUT_MINUTES=180
# RASHIFAL_SCHEDULER=0             # keep 0: the systemd timer (deploy/systemd/rashifal-refresh.timer) does the refresh
# USD_INR=88                       # only for cost estimates in logs / report meta

# ---- payments (Razorpay; docs/PAYMENTS.md) -----------------------------------------------------------------------
RAZORPAY_KEY_ID=                   # rzp_live_... (rzp_test_... while testing: the config check warns)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # the secret typed into the dashboard webhook for https://rashikundli.com/api/payments/webhook

# ---- PDF (headless Chromium via Playwright) ----------------------------------------------------------------------------
PLAYWRIGHT_BROWSERS_PATH=/srv/astrology/.playwright   # where `playwright install` puts Chromium; must be the same at install time
# PDF_CHROMIUM_EXECUTABLE=         # only if you use the distro's chromium instead
PDF_CHROMIUM_LD_LIBRARY_PATH=      # leave EMPTY on a normal server (the dev box needed unpacked libraries)
# PDF_CHROMIUM_ARGS=
# PDF_PAGE_SIZE=a5                 # the book's paper: a5 (default, booklet) or a4
# PDF_TIMEOUT_SECONDS=120
# PDF_MAX_CONCURRENT=1             # MACHINE-WIDE (file lock in var/), not per worker. A 30-60 page book
                                   # needs ~400 MB for ~3 s; keep it at 1 on a 2 GB box
# PDF_MAX_VARIANTS=5
# PDF_BASIC_CACHE_MAX=400          # free Basic Chart PDFs kept in var/pdfs/basic (oldest evicted)
# PDF_FREE_WAIT_SECONDS=2          # how long a FREE chart download queues for the render slot before it gives
                                   # up with 503 pdf_busy. Bounded on purpose: a queued request holds a FastAPI
                                   # threadpool thread and this is the ungated route, so it must not accumulate
                                   # waiters without limit. A paid book waits indefinitely and cannot be made to
                                   # refuse.
                                   #   SET IT TO 0 to make free downloads refuse INSTANTLY instead of waiting.
                                   # That is the escape hatch if the threadpool ever does come under pressure -
                                   # if /health/ready or the site as a whole is slow while PDFs are rendering,
                                   # try 0 before anything else. It costs about 1% of free downloads a 503 that
                                   # a retry fixes (measured: docs/API.md, "POST /api/chart/pdf"), and it needs
                                   # no code change and no restart beyond re-reading the environment.
# BASIC_PDF_HOURLY_LIMIT=30        # free chart RENDERS per client IP per hour - a cache hit is NOT counted.
                                   # This is the only route that runs Chromium for somebody who has not paid.
                                   # Needs TRUST_PROXY=1 behind nginx, or every visitor shares one bucket; keep
                                   # it generous, because carrier CGNAT puts thousands of phones on one IPv4
# FIRST_SALE_MARKER=var/first_live_sale.json   # written when the first LIVE-key order is paid (see LICENSE)

# ---- storage (defaults are right for /srv/astrology; all under var/, which must be persistent + backed up) ---------------
# APP_DB=var/app.db                # orders, paid balances, consultations, rashifal content
# REPORTS_DIR=var/reports          # purchased reports (JSON) - what customers paid for
# PDFS_DIR=var/pdfs                # cache, may be deleted
# SESSION_SECRET_FILE=var/session_secret   # only used when SESSION_SECRET is empty (development)

# ---- the order-link e-mail (app/mailer.py) -------------------------------------------------------
# One message per purchase: the permanent link to the order. OFF unless REPORT_EMAIL_ENABLED is set,
# so a key alone can never start sending. EMAIL_FROM's domain must be the one verified with Resend.
REPORT_EMAIL_ENABLED=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
