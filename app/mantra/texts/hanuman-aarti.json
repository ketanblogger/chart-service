{
 "slug": "hanuman-aarti",
 "verses": [
  {
   "n": "1",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "2",
   "text": "दुष्ट दलन रघुनाथ कला की"
  },
  {
   "n": "3",
   "text": "जाके बल से गिरिवर काँपे"
  },
  {
   "n": "4",
   "text": "रोग-दोष जाके निकट न झाँके"
  },
  {
   "n": "5",
   "text": "अंजनि पुत्र महा बलदाई"
  },
  {
   "n": "6",
   "text": "संतन के प्रभु सदा सहाई"
  },
  {
   "n": "7",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "8",
   "text": "दे वीरा रघुनाथ पठाए"
  },
  {
   "n": "9",
   "text": "लंका जारि सिया सुधि लाये"
  },
  {
   "n": "10",
   "text": "लंका सो कोट समुद्र सी खाई"
  },
  {
   "n": "11",
   "text": "जात पवनसुत बार न लाई"
  },
  {
   "n": "12",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "13",
   "text": "लंका जारि असुर संहारे"
  },
  {
   "n": "14",
   "text": "सियाराम जी के काज सँवारे"
  },
  {
   "n": "15",
   "text": "लक्ष्मण मूर्छित पड़े सकारे"
  },
  {
   "n": "16",
   "text": "लाये संजीवन प्राण उबारे"
  },
  {
   "n": "17",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "18",
   "text": "पैठि पाताल तोरि जमकारे"
  },
  {
   "n": "19",
   "text": "अहिरावण की भुजा उखारे"
  },
  {
   "n": "20",
   "text": "बाईं भुजा असुर दल मारे"
  },
  {
   "n": "21",
   "text": "दाहिने भुजा संतजन तारे"
  },
  {
   "n": "22",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "23",
   "text": "सुर नर मुनि जन आरती उतारें"
  },
  {
   "n": "24",
   "text": "जय जय जय हनुमान उचारें"
  },
  {
   "n": "25",
   "text": "कंचन थार कपूर लौ छाई"
  },
  {
   "n": "26",
   "text": "आरती करत अंजना माई"
  },
  {
   "n": "27",
   "text": "आरती कीजै हनुमान लला की"
  },
  {
   "n": "28",
