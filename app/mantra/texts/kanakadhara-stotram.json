{
 "slug": "kanakadhara-stotram",
 "verses": [
  {
   "n": "1",
   "text": "अङ्गं हरेः पुलकभूषणमाश्रयन्ती"
  },
  {
   "n": "2",
   "text": "भृङ्गाङ्गनेव मुकुलाभरणं तमालम्"
  },
  {
   "n": "3",
   "text": "अङ्गीकृताखिलविभूतिरपाङ्गलीला"
  },
  {
   "n": "4",
   "text": "माङ्गल्यदाऽस्तु मम मङ्गलदेवतायाः"
  },
  {
   "n": "5",
   "text": "मुग्धा मुहुर्विदधती वदने मुरारेः"
  },
  {
   "n": "6",
   "text": "प्रेमत्रपाप्रणिहितानि गतागतानि"
  },
  {
   "n": "7",
   "text": "माला दृशोर्मधुकरीव महोत्पले या"
  },
  {
   "n": "8",
   "text": "सा मे श्रियं दिशतु सागरसम्भवायाः"
  },
  {
   "n": "9",
   "text": "आमीलिताक्षमधिगम्य मुदा मुकुन्दम्–"
  },
  {
   "n": "10",
   "text": "आनन्दकन्दमनिमेषमनङ्गतन्त्रम्"
  },
  {
   "n": "11",
   "text": "आकेकरस्थितकनीनिकपक्ष्मनेत्रं"
  },
  {
   "n": "12",
   "text": "भूत्यै भवेन्मम भुजङ्गशयाङ्गनायाः"
  },
  {
   "n": "13",
   "text": "बाह्वन्तरे मधुजितः श्रितकौस्तुभे या"
  },
  {
   "n": "14",
   "text": "हारावलीव हरिनीलमयी विभाति"
  },
  {
   "n": "15",
   "text": "कामप्रदा भगवतोऽपि कटाक्षमाला"
  },
  {
   "n": "16",
   "text": "कल्याणमावहतु मे कमलालयायाः"
  },
  {
   "n": "17",
   "text": "कालाम्बुदालिललितोरसि कैटाभारेर्–"
  },
  {
   "n": "18",
   "text": "धाराधरे स्फुरति या तड़िदङ्गनेव"
  },
  {
   "n": "19",
   "text": "मातुः समस्तजगतां महनीयमूर्तिर्–"
  },
  {
   "n": "20",
   "text": "भद्राणि मे दिशतु भार्गवनन्दनायाः"
  },
  {
   "n": "21",
   "text": "प्राप्तं पदं प्रथमतः खलु यत्प्रभावान्–"
  },
  {
   "n": "22",
   "text": "माङ्गल्यभाजि मधुमाथिनि मन्मथेन"
  },
  {
   "n": "23",
   "text": "मय्यापतेत्तदिह मन्थरमीक्षणार्धं"
  },
  {
   "n": "24",
   "text": "मन्दालसं च मकरालयकन्यकायाः"
  },
  {
   "n": "25",
   "text": "विश्वामरेन्द्रपदविभ्रमदानदक्षम्–"
  },
  {
   "n": "26",
   "text": "आनन्दहेतुरधिकं मुरविद्विषोऽपि"
  },
  {
   "n": "27",
   "text": "ईषन्निषीदतु मयि क्षणमीक्षणार्धम्–"
  },
  {
   "n": "28",
   "text": "इन्दीवरोदरसहोदरमिन्दिरायाः"
  },
  {
   "n": "29",
   "text": "इष्टाविशिष्टमतयोऽपि यया दयार्द्र–"
  },
  {
   "n": "30",
   "text": "दृष्ट्या त्रिविष्टपपदं सुलभं लभन्ते"
  },
  {
   "n": "31",
   "text": "दृष्टिः प्रहृष्टकमलोदरदीप्तिरिष्टां"
  },
  {
   "n": "32",
   "text": "पुष्टिं कृषीष्ट मम पुष्करविष्टरायाः"
  },
  {
   "n": "33",
   "text": "दद्याद्दयानुपवनो द्रविणाम्बुधाराम्–"
  },
  {
   "n": "34",
   "text": "अस्मिन्नकिञ्चनविहङ्गशिशौ विषण्णे"
  },
  {
   "n": "35",
   "text": "दुष्कर्मधर्ममपनीय चिराय दूरं"
  },
  {
   "n": "36",
   "text": "नारायणप्रणयिनीनयनाम्बुवाहः"
  },
  {
   "n": "37",
   "text": "गीर्देवतेति गरुड़ध्वजसुन्दरीति"
  },
  {
   "n": "38",
   "text": "शाकम्भरीति शशिशेखरवल्लभेति"
  },
  {
   "n": "39",
   "text": "सृष्टिस्थितिप्रलयकेलिषु संस्थितायै"
  },
  {
   "n": "40",
   "text": "तस्यै नमस्त्रिभुवनैकगुरोस्तरुण्यै"
  },
  {
   "n": "41",
   "text": "श्रुत्यै नमोऽस्तु शुभकर्मफलप्रसूत्यै"
  },
  {
   "n": "42",
   "text": "रत्यै नमोऽस्तु रमणीयगुणार्णवायै"
  },
  {
   "n": "43",
   "text": "शक्त्यै नमोऽस्तु शतपत्रनिकेतनायै"
  },
  {
   "n": "44",
   "text": "पुष्ट्यै नमोऽस्तु पुरुषोत्तमवल्लभायै"
  },
  {
   "n": "45",
   "text": "नमोऽस्तु नालीकनिभाननायै"
  },
  {
   "n": "46",
   "text": "नमोऽस्तु दुग्धोदधिजन्मभूत्यै"
  },
  {
   "n": "47",
   "text": "नमोऽस्तु सोमामृतसोदरायै"
  },
  {
   "n": "48",
   "text": "नमोऽस्तु नारायणवल्लभायै"
  },
  {
   "n": "49",
   "text": "नमोऽस्तु हेमाम्बुजपीठिकायै"
  },
  {
   "n": "50",
   "text": "नमोऽस्तु भूमण्डलनायिकायै"
  },
  {
   "n": "51",
   "text": "नमोऽस्तु देवादिदयापरायै"
  },
  {
   "n": "52",
   "text": "नमोऽस्तु शार्ङ्गायुधवल्लभायै"
  },
  {
   "n": "53",
   "text": "नमोऽस्तु देव्यै भृगुनन्दनायै"
  },
  {
   "n": "54",
   "text": "नमोऽस्तु विष्णोरुरसि स्थितायै"
  },
  {
   "n": "55",
   "text": "नमोऽस्तु लक्ष्म्यै कमलालयायै"
  },
  {
   "n": "56",
   "text": "नमोऽस्तु दामोदरवल्लभायै"
  },
  {
   "n": "57",
   "text": "नमोऽस्तु कान्त्यै कमलेक्षणायै"
  },
  {
   "n": "58",
   "text": "नमोऽस्तु भूत्यै भुवनप्रसूत्यै"
  },
  {
   "n": "59",
   "text": "नमोऽस्तु देवादिभिरर्चितायै"
  },
  {
   "n": "60",
   "text": "नमोऽस्तु नन्दात्मजवल्लभायै"
  },
  {
   "n": "61",
   "text": "सम्पत्कराणि सकलेन्द्रियनन्दनानि"
  },
  {
   "n": "62",
   "text": "साम्राज्यदानविभवानि सरोरुहाक्षि"
  },
  {
   "n": "63",
   "text": "त्वद्वन्दनानि दुरितोद्धरणोद्यतानि"
  },
  {
   "n": "64",
   "text": "मामेव मातरनिशं कलयन्तु मान्ये"
  },
  {
   "n": "65",
   "text": "यत्कटाक्षसमुपासनाविधिः"
  },
  {
   "n": "66",
   "text": "सेवकस्य सकलार्थसम्पदः"
  },
  {
   "n": "67",
   "text": "सन्तनोति वचनाङ्गमानसैस्–"
  },
  {
   "n": "68",
   "text": "त्वां मुरारिहृदयेश्वरीं भजे"
  },
  {
   "n": "69",
   "text": "सरसिजनिलये सरोजहस्ते"
  },
  {
   "n": "70",
   "text": "धवलतमांशुकगन्धमाल्यशोभे"
  },
  {
   "n": "71",
   "text": "भगवति हरिवल्लभे मनोज्ञे"
  },
  {
   "n": "72",
   "text": "त्रिभुवनभूतिकरि प्रसीद मह्यम्"
  },
  {
   "n": "73",
   "text": "दिग्घस्तिभिः कनककुम्भमुखावसृष्ट–"
  },
  {
   "n": "74",
   "text": "स्वर्वाहिनीविमलचारुजलप्लुताङ्गीम्"
  },
  {
   "n": "75",
   "text": "प्रातर्नमामि जगतां जननीमशेष–"
  },
  {
   "n": "76",
   "text": "लोकाधिनाथगृहिणीममृताब्धिपुत्रीम्"
  },
  {
   "n": "77",
   "text": "कमले कमलाक्षवल्लभे त्वं"
  },
  {
   "n": "78",
   "text": "करुणापूरतरङ्गितैरपाङ्गैः"
  },
  {
   "n": "79",
   "text": "अवलोकय मामकिञ्चनानां"
  },
  {
   "n": "80",
   "text": "प्रथमं पात्रमकृत्रिमं दयायाः"
  },
  {
   "n": "81",
   "text": "देवि प्रसीद जगदीश्वरि लोकमातः"
  },
  {
   "n": "82",
   "text": "कल्याणगात्रि कमलेक्षणजीवनाथे"
  },
  {
   "n": "83",
   "text": "दारिद्र्यभीतिहृदयं शरणागतं माम्–"
  },
  {
   "n": "84",
   "text": "आलोकय प्रतिदिनं सदयैरपाङ्गैः"
  },
  {
   "n": "85",
   "text": "स्तुवन्ति ये स्तुतिभिरमूभिरन्वहं"
  },
  {
   "n": "86",
   "text": "त्रयीमयीं त्रिभुवनमातरं रमाम्"
  },
  {
   "n": "87",
   "text": "गुणाधिका गुरुतरभाग्यभागिनो"
  },
  {
   "n": "88",
   "text": "भवन्ति ते भुवि बुधभाविताशयाः"
  },
  {
   "n": "89",
   "text": "इति श्रीमच्छङ्कराचार्यकृतं श्रीकनकधारास्तोत्रं सम्पूर्णम्"
  }
 ]
}