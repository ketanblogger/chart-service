{
 "slug": "ganesh-chalisa",
 "verses": [
  {
   "n": "1",
   "text": "जय गणपति सदगुण सदन,"
  },
  {
   "n": "2",
   "text": "कविवर बदन कृपाल"
  },
  {
   "n": "3",
   "text": "विघ्न हरण मंगल करण,"
  },
  {
   "n": "4",
   "text": "जय जय गिरिजालाल"
  },
  {
   "n": "5",
   "text": "जय जय जय गणपति गणराजू"
  },
  {
   "n": "6",
   "text": "मंगल भरण करण शुभ काजू"
  },
  {
   "n": "7",
   "text": "जै गजबदन सदन सुखदाता"
  },
  {
   "n": "8",
   "text": "विश्व विनायक बुद्धि विधाता"
  },
  {
   "n": "9",
   "text": "वक्र तुण्ड शुचि शुण्ड सुहावन"
  },
  {
   "n": "10",
   "text": "तिलक त्रिपुण्ड भाल मन भावन"
  },
  {
   "n": "11",
   "text": "राजत मणि मुक्तन उर माला"
  },
  {
   "n": "12",
   "text": "स्वर्ण मुकुट शिर नयन विशाला"
  },
  {
   "n": "13",
   "text": "पुस्तक पाणि कुठार त्रिशूलं"
  },
  {
   "n": "14",
   "text": "मोदक भोग सुगन्धित फूलं"
  },
  {
   "n": "15",
   "text": "सुन्दर पीताम्बर तन साजित"
  },
  {
   "n": "16",
   "text": "चरण पादुका मुनि मन राजित"
  },
  {
   "n": "17",
   "text": "धनि शिव सुवन षडानन भ्राता"
  },
  {
   "n": "18",
   "text": "गौरी ललन विश्व-विख्याता"
  },
  {
   "n": "19",
   "text": "ऋद्धि-सिद्धि तव चंवर सुधारे"
  },
  {
   "n": "20",
   "text": "मूषक वाहन सोहत द्वारे"
  },
  {
   "n": "21",
   "text": "कहौ जन्म शुभ कथा तुम्हारी"
  },
  {
   "n": "22",
   "text": "अति शुचि पावन मंगलकारी"
  },
  {
   "n": "23",
   "text": "एक समय गिरिराज कुमारी"
  },
  {
   "n": "24",
   "text": "पुत्र हेतु तप कीन्हा भारी"
  },
  {
   "n": "25",
   "text": "भयो यज्ञ जब पूर्ण अनूपा"
  },
  {
   "n": "26",
   "text": "तब पहुंच्यो तुम धरि द्विज रूपा"
  },
  {
   "n": "27",
   "text": "अतिथि जानि कै गौरी सुखारी"
  },
  {
   "n": "28",
   "text": "बहुविधि सेवा करी तुम्हारी"
  },
  {
   "n": "29",
   "text": "अति प्रसन्न ह्वै तुम वर दीन्हा"
  },
  {
   "n": "30",
   "text": "मातु पुत्र हित जो तप कीन्हा"
  },
  {
   "n": "31",
   "text": "मिलहि पुत्र तुहि, बुद्धि विशाला"
  },
  {
   "n": "32",
   "text": "बिना गर्भ धारण यहि काला"
  },
  {
   "n": "33",
   "text": "गणनायक गुण ज्ञान निधाना"
  },
  {
   "n": "34",
   "text": "पूजित प्रथम रूप भगवाना"
  },
  {
   "n": "35",
   "text": "अस कहि अन्तर्धान रूप ह्वै"
  },
  {
   "n": "36",
   "text": "पलना पर बालक स्वरूप ह्वै"
  },
  {
   "n": "37",
   "text": "बनि शिशु रुदन जबहिं तुम ठाना"
  },
  {
   "n": "38",
   "text": "लखि मुख सुख नहिं गौरी समाना"
  },
  {
   "n": "39",
   "text": "सकल मगन, सुखमंगल गावहिं"
  },
  {
   "n": "40",
   "text": "नभ ते सुरन, सुमन वर्षावहिं"
  },
  {
   "n": "41",
   "text": "शम्भु, उमा, बहुदान लुटावहिं"
  },
  {
   "n": "42",
   "text": "सुर मुनिजन, सुत देखन आवहिं"
  },
  {
   "n": "43",
   "text": "लखि अति आनन्द मंगल साजा"
  },
  {
   "n": "44",
   "text": "देखन भी आये शनि राजा"
  },
  {
   "n": "45",
   "text": "निज अवगुण गुनि शनि मन माहीं"
  },
  {
   "n": "46",
   "text": "बालक, देखन चाहत नाहीं"
  },
  {
   "n": "47",
   "text": "गिरिजा कछु मन भेद बढायो"
  },
  {
   "n": "48",
   "text": "उत्सव मोर, न शनि तुही भायो"
  },
  {
   "n": "49",
   "text": "कहन लगे शनि, मन सकुचाई"
  },
  {
   "n": "50",
   "text": "का करिहौ, शिशु मोहि दिखाई"
  },
  {
   "n": "51",
   "text": "नहिं विश्वास, उमा उर भयऊ"
  },
  {
   "n": "52",
   "text": "शनि सों बालक देखन कहयऊ"
  },
  {
   "n": "53",
   "text": "पड़तहिं शनि दृग कोण प्रकाशा"
  },
  {
   "n": "54",
   "text": "बालक सिर उड़ि गयो अकाशा"
  },
  {
   "n": "55",
   "text": "गिरिजा गिरी विकल ह्वै धरणी"
  },
  {
   "n": "56",
   "text": "सो दुःख दशा गयो नहीं वरणी"
  },
  {
   "n": "57",
   "text": "हाहाकार मच्यौ कैलाशा"
  },
  {
   "n": "58",
   "text": "शनि कीन्हों लखि सुत को नाशा"
  },
  {
   "n": "59",
   "text": "तुरत गरुड़ चढ़ि विष्णु सिधायो"
  },
  {
   "n": "60",
   "text": "काटी चक्र सो गज सिर लाये"
  },
  {
   "n": "61",
   "text": "बालक के धड़ ऊपर धारयो"
  },
  {
   "n": "62",
   "text": "प्राण मन्त्र पढ़ि शंकर डारयो"
  },
  {
   "n": "63",
   "text": "नाम गणेश शम्भु तब कीन्हे"
  },
  {
   "n": "64",
   "text": "प्रथम पूज्य बुद्धि निधि, वर दीन्हे"
  },
  {
   "n": "65",
   "text": "बुद्धि परीक्षा जब शिव कीन्हा"
  },
  {
   "n": "66",
   "text": "पृथ्वी कर प्रदक्षिणा लीन्हा"
  },
  {
   "n": "67",
   "text": "चले षडानन, भरमि भुलाई"
  },
  {
   "n": "68",
   "text": "रचे बैठ तुम बुद्धि उपाई"
  },
  {
   "n": "69",
   "text": "चरण मातु-पितु के धर लीन्हें"
  },
  {
   "n": "70",
   "text": "तिनके सात प्रदक्षिण कीन्हें"
  },
  {
   "n": "71",
   "text": "धनि गणेश कही शिव हिये हरषे"
  },
  {
   "n": "72",
   "text": "नभ ते सुरन सुमन बहु बरसे"
  },
  {
   "n": "73",
   "text": "तुम्हरी महिमा बुद्धि बड़ाई"
  },
  {
   "n": "74",
   "text": "शेष सहसमुख सके न गाई"
  },
  {
   "n": "75",
   "text": "मैं मतिहीन मलीन दुखारी"
  },
  {
   "n": "76",
   "text": "करहूं कौन विधि विनय तुम्हारी"
  },
  {
   "n": "77",
   "text": "भजत रामसुन्दर प्रभुदासा"
  },
  {
   "n": "78",
   "text": "जग प्रयाग, ककरा, दुर्वासा"
  },
  {
   "n": "79",
   "text": "अब प्रभु दया दीन पर कीजै"
  },
  {
   "n": "80",
   "text": "अपनी भक्ति शक्ति कछु दीजै"
  },
  {
   "n": "81",
   "text": "श्री गणेश यह चालीसा,"
  },
  {
   "n": "82",
   "text": "पाठ करै कर ध्यान"
  },
  {
   "n": "83",
   "text": "नित नव मंगल गृह बसै,"
  },
  {
   "n": "84",
   "text": "लहे जगत सन्मान"
  },
  {
   "n": "85",
   "text": "सम्वत अपन सहस्र दश"
  },
  {
   "n": "86",
   "text": "ऋषि पंचमी दिनेश"
  },
  {
   "n": "87",
   "text": "पूरण चालीसा भयो,"
  },
  {
   "n": "88",
   "text": "मंगल मूर्ति गणेश"
  }
 ]
}