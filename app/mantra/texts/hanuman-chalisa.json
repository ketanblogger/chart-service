{
 "slug": "hanuman-chalisa",
 "verses": [
  {
   "n": "1",
   "text": "श्रीगुरु चरन सरोज रज"
  },
  {
   "n": "2",
   "text": "निज मनु मुकुरु सुधारि"
  },
  {
   "n": "3",
   "text": "बरनउँ रघुबर बिमल जसु"
  },
  {
   "n": "4",
   "text": "जो दायकु फल चारि"
  },
  {
   "n": "5",
   "text": "बुद्धिहीन तनु जानिके"
  },
  {
   "n": "6",
   "text": "सुमिरौं पवन-कुमार"
  },
  {
   "n": "7",
   "text": "बल बुधि बिद्या देहु मोहिं"
  },
  {
   "n": "8",
   "text": "हरहु कलेस बिकार"
  },
  {
   "n": "9",
   "text": "जय हनुमान ज्ञान गुन सागर"
  },
  {
   "n": "10",
   "text": "जय कपीस तिहुँ लोक उजागर"
  },
  {
   "n": "11",
   "text": "राम दूत अतुलित बल धामा"
  },
  {
   "n": "12",
   "text": "अंजनि पुत्र पवनसुत नामा"
  },
  {
   "n": "13",
   "text": "महाबीर बिक्रम बजरंगी"
  },
  {
   "n": "14",
   "text": "कुमति निवार सुमति के संगी"
  },
  {
   "n": "15",
   "text": "कंचन बरन बिराज सुबेसा"
  },
  {
   "n": "16",
   "text": "कानन कुण्डल कुँचित केसा"
  },
  {
   "n": "17",
   "text": "हाथ बज्र औ ध्वजा बिराजै"
  },
  {
   "n": "18",
   "text": "काँधे मूँज जनेऊ साजै"
  },
  {
   "n": "19",
   "text": "शंकर सुवन केसरीनंदन"
  },
  {
   "n": "20",
   "text": "तेज प्रताप महा जगवंदन"
  },
  {
   "n": "21",
   "text": "बिद्यावान गुनी अति चातुर"
  },
  {
   "n": "22",
   "text": "राम काज करिबे को आतुर"
  },
  {
   "n": "23",
   "text": "प्रभु चरित्र सुनिबे को रसिया"
  },
  {
   "n": "24",
   "text": "राम लखन सीता मन बसिया"
  },
  {
   "n": "25",
   "text": "सूक्ष्म रूप धरि सियहिं दिखावा"
  },
  {
   "n": "26",
   "text": "बिकट रूप धरि लंक जरावा"
  },
  {
   "n": "27",
   "text": "भीम रूप धरि असुर सँहारे"
  },
  {
   "n": "28",
   "text": "रामचन्द्र के काज सँवारे"
  },
  {
   "n": "29",
   "text": "लाय सजीवन लखन जियाए"
  },
  {
   "n": "30",
   "text": "श्री रघुबीर हरषि उर लाये"
  },
  {
   "n": "31",
   "text": "रघुपति कीन्ही बहुत बड़ाई"
  },
  {
   "n": "32",
   "text": "तुम मम प्रिय भरतहि सम भाई"
  },
  {
   "n": "33",
   "text": "सहस बदन तुम्हरो जस गावैं"
  },
  {
   "n": "34",
   "text": "अस कहि श्रीपति कण्ठ लगावैं"
  },
  {
   "n": "35",
   "text": "सनकादिक ब्रह्मादि मुनीसा"
  },
  {
   "n": "36",
   "text": "नारद सारद सहित अहीसा"
  },
  {
   "n": "37",
   "text": "जम कुबेर दिगपाल जहाँ ते"
  },
  {
   "n": "38",
   "text": "कबि कोबिद कहि सके कहाँ ते"
  },
  {
   "n": "39",
   "text": "तुम उपकार सुग्रीवहिं कीन्हा"
  },
  {
   "n": "40",
   "text": "राम मिलाय राज पद दीन्हा"
  },
  {
   "n": "41",
   "text": "तुम्हरो मंत्र बिभीषण माना"
  },
  {
   "n": "42",
   "text": "लंकेश्वर भए सब जग जाना"
  },
  {
   "n": "43",
   "text": "जुग सहस्र जोजन पर भानू"
  },
  {
   "n": "44",
   "text": "लील्यो ताहि मधुर फल जानू"
  },
  {
   "n": "45",
   "text": "प्रभु मुद्रिका मेलि मुख माहीं"
  },
  {
   "n": "46",
   "text": "जलधि लाँघि गये अचरज नाहीं"
  },
  {
   "n": "47",
   "text": "दुर्गम काज जगत के जेते"
  },
  {
   "n": "48",
   "text": "सुगम अनुग्रह तुम्हरे तेते"
  },
  {
   "n": "49",
   "text": "राम दुआरे तुम रखवारे"
  },
  {
   "n": "50",
   "text": "होत न आज्ञा बिनु पैसारे"
  },
  {
   "n": "51",
   "text": "सब सुख लहै तुम्हारी सरना"
  },
  {
   "n": "52",
   "text": "तुम रक्षक काहू को डरना"
  },
  {
   "n": "53",
   "text": "आपन तेज सम्हारो आपै"
  },
  {
   "n": "54",
   "text": "तीनों लोक हाँक तें काँपै"
  },
  {
   "n": "55",
   "text": "भूत पिशाच निकट नहिं आवै"
  },
  {
   "n": "56",
   "text": "महावीर जब नाम सुनावै"
  },
  {
   "n": "57",
   "text": "नासै रोग हरै सब पीरा"
  },
  {
   "n": "58",
   "text": "जपत निरंतर हनुमत बीरा"
  },
  {
   "n": "59",
   "text": "संकट तें हनुमान छुड़ावै"
  },
  {
   "n": "60",
   "text": "मन क्रम बचन ध्यान जो लावै"
  },
  {
   "n": "61",
   "text": "सब पर राम तपस्वी राजा"
  },
  {
   "n": "62",
   "text": "तिनके काज सकल तुम साजा"
  },
  {
   "n": "63",
   "text": "और मनोरथ जो कोई लावै"
  },
  {
   "n": "64",
   "text": "सोई अमित जीवन फल पावै"
  },
  {
   "n": "65",
   "text": "चारों जुग परताप तुम्हारा"
  },
  {
   "n": "66",
   "text": "है परसिद्ध जगत उजियारा"
  },
  {
   "n": "67",
   "text": "साधु सन्त के तुम रखवारे"
  },
  {
   "n": "68",
   "text": "असुर निकंदन राम दुलारे"
  },
  {
   "n": "69",
   "text": "अष्ट सिद्धि नौ निधि के दाता"
  },
  {
   "n": "70",
   "text": "अस बर दीन जानकी माता"
  },
  {
   "n": "71",
   "text": "राम रसायन तुम्हरे पासा"
  },
  {
   "n": "72",
   "text": "सदा रहो रघुपति के दासा"
  },
  {
   "n": "73",
   "text": "तुम्हरे भजन राम को पावै"
  },
  {
   "n": "74",
   "text": "जनम जनम के दुख बिसरावै"
  },
  {
   "n": "75",
   "text": "अंतकाल रघुवरपुर जाई"
  },
  {
   "n": "76",
   "text": "जहाँ जन्म हरिभक्त कहाई"
  },
  {
   "n": "77",
   "text": "और देवता चित्त न धरई"
  },
  {
   "n": "78",
   "text": "हनुमत सेइ सर्ब सुख करई"
  },
  {
   "n": "79",
   "text": "संकट कटै मिटै सब पीरा"
  },
  {
   "n": "80",
   "text": "जो सुमिरै हनुमत बलबीरा"
  },
  {
   "n": "81",
   "text": "जै जै जै हनुमान गोसाईं"
  },
  {
   "n": "82",
   "text": "कृपा करहु गुरुदेव की नाईं"
  },
  {
   "n": "83",
   "text": "जो सत बार पाठ कर कोई"
  },
  {
   "n": "84",
   "text": "छूटहि बंदि महा सुख होई"
  },
  {
   "n": "85",
   "text": "जो यह पढ़ै हनुमान चालीसा"
  },
  {
   "n": "86",
   "text": "होय सिद्धि साखी गौरीसा"
  },
  {
   "n": "87",
   "text": "तुलसीदास सदा हरि चेरा"
  },
  {
   "n": "88",
   "text": "कीजै नाथ हृदय महँ डेरा"
  },
  {
   "n": "89",
   "text": "पवन तनय संकट हरन,"
  },
  {
   "n": "90",
   "text": "मंगल मूरति रूप"
  },
  {
   "n": "91",
   "text": "राम लखन सीता सहित,"
  },
  {
   "n": "92",
   "text": "हृदय बसहु सुर भूप"
  }
 ]
