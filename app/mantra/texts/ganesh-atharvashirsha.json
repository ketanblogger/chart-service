{
 "slug": "ganesh-atharvashirsha",
 "verses": [
  {
   "n": "1",
   "text": "ॐ भद्रं कर्णेभिः शृणुयाम देवाः"
  },
  {
   "n": "2",
   "text": "भद्रं पश्येमाक्षभिर्यजत्राः"
  },
  {
   "n": "3",
   "text": "स्थिरैरङ्गैस्तुष्टुवांसस्तनूभिः"
  },
  {
   "n": "4",
   "text": "व्यशेम देवहितं यदायुः"
  },
  {
   "n": "5",
   "text": "ॐ स्वस्ति न इन्द्रो वृद्धश्रवाः"
  },
  {
   "n": "6",
   "text": "स्वस्ति नः पूषा विश्ववेदाः"
  },
  {
   "n": "7",
   "text": "स्वस्तिनस्तार्क्ष्यो अरिष्टनेमिः"
  },
  {
   "n": "8",
   "text": "स्वस्ति नो बृहस्पतिर्दधातु"
  },
  {
   "n": "9",
   "text": "ॐ तन्मामवतु तद् वक्तारमवतु अवतु माम् अवतु वक्तारम्"
  },
  {
   "n": "10",
   "text": "ॐ शान्तिः शान्तिः शान्तिः"
  },
  {
   "n": "11",
   "text": "हरिः ॐ नमस्ते गणपतये"
  },
  {
   "n": "12",
   "text": "त्वमेव प्रत्यक्षं तत्त्वमसि"
  },
  {
   "n": "13",
   "text": "त्वमेव केवलं कर्ताऽसि"
  },
  {
   "n": "14",
   "text": "त्वमेव केवलं धर्ताऽसि"
  },
  {
   "n": "15",
   "text": "त्वमेव केवलं हर्ताऽसि"
  },
  {
   "n": "16",
   "text": "त्वमेव सर्वं खल्विदं ब्रह्मासि"
  },
  {
   "n": "17",
   "text": "त्वं साक्षादात्माऽसि नित्यम्"
  },
  {
   "n": "18",
   "text": "ऋतं वच्मि"
  },
  {
   "n": "19",
   "text": "सत्यं वच्मि"
  },
  {
   "n": "20",
   "text": "अव त्वं माम्"
  },
  {
   "n": "21",
   "text": "अव वक्तारम्"
  },
  {
   "n": "22",
   "text": "अव श्रोतारम्"
  },
  {
   "n": "23",
   "text": "अवानूचानमव शिष्यम्"
  },
  {
   "n": "24",
   "text": "अव पश्चात्तात्"
  },
  {
   "n": "25",
   "text": "अव पुरस्तात्"
  },
  {
   "n": "26",
   "text": "अवोत्तरात्तात्"
  },
  {
   "n": "27",
   "text": "अव दक्षिणात्तात्"
  },
  {
   "n": "28",
   "text": "अव चोर्ध्वात्तात्"
  },
  {
   "n": "29",
   "text": "अवाधरात्तात्"
  },
  {
   "n": "30",
   "text": "सर्वतो मां पाहि पाहि समन्तात्"
  },
  {
   "n": "31",
   "text": "त्वं वाङ्ग्मयस्त्वं चिन्मयः"
  },
  {
   "n": "32",
   "text": "त्वमानन्दमयस्त्वं ब्रह्ममयः"
  },
  {
   "n": "33",
   "text": "त्वं सच्चिदानन्दाद्वितीयोऽसि"
  },
  {
   "n": "34",
   "text": "त्वं प्रत्यक्षं ब्रह्मासि"
  },
  {
   "n": "35",
   "text": "त्वं ज्ञानमयो विज्ञानमयोऽसि"
  },
  {
   "n": "36",
   "text": "सर्वं जगदिदं त्वत्तो जायते"
  },
  {
   "n": "37",
   "text": "सर्वं जगदिदं त्वत्तस्तिष्ठति"
  },
  {
   "n": "38",
   "text": "सर्वं जगदिदं त्वयि लयमेष्यति"
  },
  {
   "n": "39",
   "text": "सर्वं जगदिदं त्वयि प्रत्येति"
  },
  {
   "n": "40",
   "text": "त्वं भूमिरापोऽनलोऽनिलो नभः"
  },
  {
   "n": "41",
   "text": "त्वं चत्वारि वाक्पदानि"
  },
  {
   "n": "42",
   "text": "त्वं गुणत्रयातीतः"
  },
  {
   "n": "43",
   "text": "त्वमवस्थात्रयातीतः"
  },
  {
   "n": "44",
   "text": "त्वं देहत्रयातीतः"
  },
  {
   "n": "45",
   "text": "त्वं कालत्रयातीतः"
  },
  {
   "n": "46",
   "text": "त्वं मूलाधारः स्थितोऽसि नित्यम्"
  },
  {
   "n": "47",
   "text": "त्वं शक्तित्रयात्मकः"
  },
  {
   "n": "48",
   "text": "त्वां योगिनो ध्यायन्ति नित्यम्"
  },
  {
   "n": "49",
   "text": "त्वं ब्रह्मा त्वं विष्णुस्त्वं रुद्रस्त्वमिन्द्रस्त्वमग्निस्त्वं वायुस्त्वं सूर्यस्त्वं चन्द्रमास्त्वं ब्रह्म भूर्भुवः स्वरोम्"
  },
  {
   "n": "50",
   "text": "गणादिं पूर्वमुच्चार्य वर्णादींस्तदनन्तरम्"
  },
  {
   "n": "51",
   "text": "अनुस्वारः परतरः"
  },
  {
   "n": "52",
   "text": "अर्धेन्दुलसितम्"
  },
  {
   "n": "53",
   "text": "तारेण ऋद्धम्"
  },
  {
   "n": "54",
   "text": "एतत्तव मनुस्वरूपम्"
  },
  {
   "n": "55",
   "text": "गकारः पूर्वरूपम्"
  },
  {
   "n": "56",
   "text": "अकारो मध्यमरूपम्"
  },
  {
   "n": "57",
   "text": "अनुस्वारश्चान्त्यरूपम्"
  },
  {
   "n": "58",
   "text": "बिन्दुरुत्तररूपम्"
  },
  {
   "n": "59",
   "text": "नादः सन्धानम्"
  },
  {
   "n": "60",
   "text": "संहितासन्धिः"
  },
  {
   "n": "61",
   "text": "सैषा गणेशविद्या"
  },
  {
   "n": "62",
   "text": "निचृद्गायत्रीच्छन्दः"
  },
  {
   "n": "63",
   "text": "गणपतिर्देवता"
  },
  {
   "n": "64",
   "text": "ॐ गं गणपतये नमः"
  },
  {
   "n": "65",
   "text": "एकदन्ताय विद्महे वक्रतुण्डाय धीमहि"
  },
  {
   "n": "66",
   "text": "तन्नो दन्ती प्रचोदयात्"
  },
  {
   "n": "67",
   "text": "एकदन्तं चतुर्हस्तं पाशमङ्कुशधारिणम्"
  },
  {
   "n": "68",
   "text": "रदं च वरदं हस्तैर्बिभ्राणं मूषकध्वजम्"
  },
  {
   "n": "69",
   "text": "रक्तं लम्बोदरं शूर्पकर्णकं रक्तवाससम्"
  },
  {
   "n": "70",
   "text": "रक्तगन्धानुलिप्ताङ्गं रक्तपुष्पैः सुपूजितम्"
  },
  {
   "n": "71",
   "text": "भक्तानुकम्पिनं देवं जगत्कारणमच्युतम्"
  },
  {
   "n": "72",
   "text": "आविर्भूतं च सृष्ट्यादौ प्रकृतेः पुरुषात्परम्"
  },
  {
   "n": "73",
   "text": "एवं ध्यायति यो नित्यं स योगी योगिनां वरः"
  },
  {
   "n": "74",
   "text": "नमो व्रातपतये नमो गणपतये नमः प्रमथपतये"
  },
  {
   "n": "75",
   "text": "नमस्तेऽस्तु लम्बोदरायैकदन्ताय विघ्ननाशिने शिवसुताय"
  },
  {
   "n": "76",
   "text": "श्रीवरदमूर्तये नमो नमः"
  },
  {
   "n": "77",
   "text": "एतदथर्वशीर्षं योऽधीते"
  },
  {
   "n": "78",
   "text": "स ब्रह्मभूयाय कल्पते"
  },
  {
   "n": "79",
   "text": "स सर्वतः सुखमेधते"
  },
  {
   "n": "80",
   "text": "स सर्वविघ्नैर्न बाध्यते"
  },
  {
   "n": "81",
   "text": "स पञ्चमहापापात्प्रमुच्यते"
  },
  {
   "n": "82",
   "text": "सायमधीयानो दिवसकृतं पापं नाशयति"
  },
  {
   "n": "83",
   "text": "प्रातरधीयानो रात्रिकृतं पापं नाशयति"
  },
  {
   "n": "84",
   "text": "सायम्प्रातः प्रयुञ्जानो अपापो भवति"
  },
  {
   "n": "85",
   "text": "सर्वत्राधीयानोऽपविघ्नो भवति"
  },
  {
   "n": "86",
   "text": "धर्मार्थकाममोक्षं च विन्दति"
  },
  {
   "n": "87",
   "text": "इदमथर्वशीर्षमशिष्याय न देयम्"
  },
  {
   "n": "88",
   "text": "यो यदि मोहाद्दास्यति स पापीयान् भवति"
  },
  {
   "n": "89",
   "text": "सहस्रावर्तनाद्यं यं काममधीते तं तमनेन साधयेत्"
  },
  {
   "n": "90",
   "text": "अनेन गणपतिमभिषिञ्चति स वाग्मी भवति"
  },
  {
   "n": "91",
   "text": "चतुर्थ्यामनश्नन् जपति स विद्यावान् भवति"
  },
  {
   "n": "92",
   "text": "स यशोवान् भवति"
  },
  {
   "n": "93",
   "text": "इत्यथर्वणवाक्यम्"
  },
  {
   "n": "94",
   "text": "ब्रह्माद्याचरणं विद्यात् न बिभेति कदाचनेति"
  },
  {
   "n": "95",
   "text": "यो दूर्वाङ्कुरैर्यजति स वैश्रवणोपमो भवति"
  },
  {
   "n": "96",
   "text": "यो लाजैर्यजति स यशोवान् भवति"
  },
  {
   "n": "97",
   "text": "स मेधावान् भवति"
  },
  {
   "n": "98",
   "text": "यो मोदकसहस्रेण यजति"
  },
  {
   "n": "99",
   "text": "स वाञ्छितफलमवाप्नोति"
  },
  {
   "n": "100",
   "text": "यः साज्यसमिद्भिर्यजति"
  },
  {
   "n": "101",
   "text": "स सर्वं लभते स सर्वं लभते"
  },
  {
   "n": "102",
   "text": "अष्टौ ब्राह्मणान् सम्यग्ग्राहयित्वा सूर्यवर्चस्वी भवति"
  },
  {
   "n": "103",
   "text": "महाविघ्नात्प्रमुच्यते"
  },
  {
   "n": "104",
   "text": "महादोषात्प्रमुच्यते"
  },
  {
   "n": "105",
   "text": "महापापात् प्रमुच्यते"
  },
  {
   "n": "106",
   "text": "स सर्वविद्भवति स सर्वविद्भवति"
  },
  {
   "n": "107",
   "text": "य एवं वेद इत्युपनिषत्"
  },
  {
   "n": "108",
   "text": "ॐ सह नाववतु"
  },
  {
   "n": "109",
   "text": "सह नौ भुनक्तु"
  },
  {
   "n": "110",
   "text": "सहनौभुनक्तु"
  },
  {
   "n": "111",
   "text": "सह वीर्यं करवावहै"
  },
  {
   "n": "112",
   "text": "तेजस्विनावधीतमस्तु मा विद्विषावहै"
  },
  {
   "n": "113",
   "text": "ॐ भद्रं कर्णेभिः शृणुयाम देवाः"
  },
  {
   "n": "114",
   "text": "भद्रं पश्येमाक्षभिर्यजत्राः"
  },
  {
   "n": "115",
   "text": "स्थिरैरङ्गैस्तुष्टुवांसस्तनूभिः"
  },
  {
   "n": "116",
   "text": "व्यशेम देवहितं यदायुः"
  },
  {
   "n": "117",
   "text": "ॐ स्वस्ति न इन्द्रो वृद्धश्रवाः"
  },
  {
   "n": "118",
   "text": "स्वस्ति नः पूषा विश्ववेदाः"
  },
  {
   "n": "119",
   "text": "स्वस्तिनस्तार्क्ष्यो अरिष्टनेमिः"
  },
  {
   "n": "120",
   "text": "स्वस्ति नो बृहस्पतिर्दधातु"
  },
  {
   "n": "121",
   "text": "ॐ शान्तिः शान्तिः शान्तिः"
  },
  {
   "n": "122",
   "text": "इति श्रीगणपत्यथर्वशीर्षं समाप्तम्"
  }
 ]
}