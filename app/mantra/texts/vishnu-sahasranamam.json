{
 "slug": "vishnu-sahasranamam",
 "verses": [
  {
   "n": "1",
   "text": "→ → श्री विष्णु सहस्रनाम स्तोत्रम्"
  },
  {
   "n": "2",
   "text": "पूर्वपीठिका"
  },
  {
   "n": "3",
   "text": "शुक्लाम्बरधरं विष्णुं शशिवर्णं चतुर्भुजम्"
  },
  {
   "n": "4",
   "text": "प्रसन्नवदनं ध्यायेत् सर्वविघ्नोपशान्तये"
  },
  {
   "n": "5",
   "text": "यस्य द्विरदवक्त्राद्याः पारिषद्याः परश्शतम्"
  },
  {
   "n": "6",
   "text": "विघ्नं निघ्नन्ति सततं विष्वक्सेनं तमाश्रये"
  },
  {
   "n": "7",
   "text": "व्यासं वसिष्ठनप्तारं शक्तेः पौत्रमकल्मषम्"
  },
  {
   "n": "8",
   "text": "पराशरात्मजं वन्दे शुकतातं तपोनिधिम्"
  },
  {
   "n": "9",
   "text": "व्यासाय विष्णुरूपाय व्यासरूपाय विष्णवे"
  },
  {
   "n": "10",
   "text": "नमो वै ब्रह्मनिधये वासिष्ठाय नमो नमः"
  },
  {
   "n": "11",
   "text": "अविकाराय शुद्धाय नित्याय परमात्मने"
  },
  {
   "n": "12",
   "text": "सदैकरूपरूपाय विष्णवे सर्वजिष्णवे"
  },
  {
   "n": "13",
   "text": "यस्य स्मरणमात्रेण जन्मसंसारबन्धनात्"
  },
  {
   "n": "14",
   "text": "विमुच्यते नमस्तस्मै विष्णवे प्रभविष्णवे"
  },
  {
   "n": "15",
   "text": "ॐ नमो विष्णवे प्रभविष्णवे"
  },
  {
   "n": "16",
   "text": "श्रीवैशम्पायन उवाच"
  },
  {
   "n": "17",
   "text": "श्रुत्वा धर्मानशेषेण पावनानि च सर्वशः"
  },
  {
   "n": "18",
   "text": "युधिष्ठिरः शान्तनवं पुनरेवाभ्यभाषत"
  },
  {
   "n": "19",
   "text": "युधिष्ठिर उवाच"
  },
  {
   "n": "20",
   "text": "किमेकं दैवतं लोके किं वाप्येकं परायणम्"
  },
  {
   "n": "21",
   "text": "स्तुवन्तः कं कमर्चन्तः प्राप्नुयुर्मानवाः शुभम्"
  },
  {
   "n": "22",
   "text": "को धर्मः सर्वधर्माणां भवतः परमो मतः"
  },
  {
   "n": "23",
   "text": "किं जपन्मुच्यते जन्तुर्जन्मसंसारबन्धनात्"
  },
  {
   "n": "24",
   "text": "श्री भीष्म उवाच"
  },
  {
   "n": "25",
   "text": "जगत्प्रभुं देवदेवमनन्तं पुरुषोत्तमम्"
  },
  {
   "n": "26",
   "text": "स्तुवन्नामसहस्रेण पुरुषः सततोत्थितः"
  },
  {
   "n": "27",
   "text": "तमेव चार्चयन्नित्यं भक्त्या पुरुषमव्ययम्"
  },
  {
   "n": "28",
   "text": "ध्यायन् स्तुवन्नमस्यंश्च यजमानस्तमेव च"
  },
  {
   "n": "29",
   "text": "अनादिनिधनं विष्णुं सर्वलोकमहेश्वरम्"
  },
  {
   "n": "30",
   "text": "लोकाध्यक्षं स्तुवन्नित्यं सर्वदुःखातिगो भवेत्"
  },
  {
   "n": "31",
   "text": "ब्रह्मण्यं सर्वधर्मज्ञं लोकानां कीर्तिवर्धनम्"
  },
  {
   "n": "32",
   "text": "लोकनाथं महद्भूतं सर्वभूतभवोद्भवम्"
  },
  {
   "n": "33",
   "text": "एष मे सर्वधर्माणां धर्मोऽधिकतमो मतः"
  },
  {
   "n": "34",
   "text": "यद्भक्त्या पुण्डरीकाक्षं स्तवैरर्चेन्नरः सदा"
  },
  {
   "n": "35",
   "text": "परमं यो महत्तेजः परमं यो महत्तपः"
  },
  {
   "n": "36",
   "text": "परमं यो महद्ब्रह्म परमं यः परायणम्"
  },
  {
   "n": "37",
   "text": "पवित्राणां पवित्रं यो मङ्गलानां च मङ्गलम्"
  },
  {
   "n": "38",
   "text": "दैवतं दैवतानां च भूतानां योऽव्ययः पिता"
  },
  {
   "n": "39",
   "text": "यतः सर्वाणि भूतानि भवन्त्यादियुगागमे"
  },
  {
   "n": "40",
   "text": "यस्मिंश्च प्रलयं यान्ति पुनरेव युगक्षये"
  },
  {
   "n": "41",
   "text": "तस्य लोकप्रधानस्य जगन्नाथस्य भूपते"
  },
  {
   "n": "42",
   "text": "विष्णोर्नामसहस्रं मे शृणु पापभयापहम्"
  },
  {
   "n": "43",
   "text": "यानि नामानि गौणानि विख्यातानि महात्मनः"
  },
  {
   "n": "44",
   "text": "ऋषिभिः परिगीतानि तानि वक्ष्यामि भूतये"
  },
  {
   "n": "45",
   "text": "ऋषिर्नाम्नां सहस्रस्य वेदव्यासो महामुनिः"
  },
  {
   "n": "46",
   "text": "छन्दोऽनुष्टुप् तथा देवो भगवान् देवकीसुतः"
  },
  {
   "n": "47",
   "text": "अमृतांशूद्भवो बीजं शक्तिर्देवकिनन्दनः"
  },
  {
   "n": "48",
   "text": "त्रिसामा हृदयं तस्य शान्त्यर्थे विनियुज्यते"
  },
  {
   "n": "49",
   "text": "विष्णुं जिष्णुं महाविष्णुं प्रभविष्णुं महेश्वरम्"
  },
  {
   "n": "50",
   "text": "अनेकरूप दैत्यान्तं नमामि पुरुषोत्तमम्"
  },
  {
   "n": "51",
   "text": "क्षीरोदन्वत्प्रदेशे शुचिमणिविलसत्सैकते मौक्तिकानां"
  },
  {
   "n": "52",
   "text": "मालाक्लुप्तासनस्थः स्फटिकमणिनिभैर्मौक्तिकैर्मण्डिताङ्गः"
  },
  {
   "n": "53",
   "text": "शुभ्रैरभ्रैरदभ्रैरुपरिविरचितैर्मुक्तपीयूषवर्षै-"
  },
  {
   "n": "54",
   "text": "-रानन्दी नः पुनीयादरिनलिनगदाशङ्खपाणिर्मुकुन्दः"
  },
  {
   "n": "55",
   "text": "भूः पादौ यस्य नाभिर्वियदसुरनिलश्चन्द्र सूर्यौ च नेत्रे"
  },
  {
   "n": "56",
   "text": "कर्णावासाः शिरो द्यौर्मुखमपि दहनो यस्य वास्तेयमब्धिः"
  },
  {
   "n": "57",
   "text": "अन्तःस्थं यस्य विश्वं सुरनरखगगोभोगिगन्धर्वदैत्यैः"
  },
  {
   "n": "58",
   "text": "चित्रं रंरम्यते तं त्रिभुवनवपुषं विष्णुमीशं नमामि"
  },
  {
   "n": "59",
   "text": "शान्ताकारं भुजगशयनं पद्मनाभं सुरेशं"
  },
  {
   "n": "60",
   "text": "विश्वाकारं गगनसदृशं मेघवर्णं शुभाङ्गम्"
  },
  {
   "n": "61",
   "text": "लक्ष्मीकान्तं कमलनयनं योगिहृद्ध्यानगम्यं"
  },
  {
   "n": "62",
   "text": "वन्दे विष्णुं भवभयहरं सर्वलोकैकनाथम्"
  },
  {
   "n": "63",
   "text": "मेघश्यामं पीतकौशेयवासं"
  },
  {
   "n": "64",
   "text": "श्रीवत्साङ्कं कौस्तुभोद्भासिताङ्गम्"
  },
  {
   "n": "65",
   "text": "पुण्योपेतं पुण्डरीकायताक्षं"
  },
  {
   "n": "66",
   "text": "विष्णुं वन्दे सर्वलोकैकनाथम्"
  },
  {
   "n": "67",
   "text": "नमः समस्तभूतानामादिभूताय भूभृते"
  },
  {
   "n": "68",
   "text": "अनेकरूपरूपाय विष्णवे प्रभविष्णवे"
  },
  {
   "n": "69",
   "text": "सशङ्खचक्रं सकिरीटकुण्डलं"
  },
  {
   "n": "70",
   "text": "सपीतवस्त्रं सरसीरुहेक्षणम्"
  },
  {
   "n": "71",
   "text": "सहारवक्षःस्थलशोभिकौस्तुभं"
  },
  {
   "n": "72",
   "text": "नमामि विष्णुं शिरसा चतुर्भुजम्"
  },
  {
   "n": "73",
   "text": "छायायां पारिजातस्य हेमसिंहासनोपरि"
  },
  {
   "n": "74",
   "text": "आसीनमम्बुदश्याममायताक्षमलङ्कृतम्"
  },
  {
   "n": "75",
   "text": "चन्द्राननं चतुर्बाहुं श्रीवत्साङ्कित वक्षसं"
  },
  {
   "n": "76",
   "text": "रुक्मिणी सत्यभामाभ्यां सहितं कृष्णमाश्रये"
  },
  {
   "n": "77",
   "text": "विश्वं विष्णुर्वषट्कारो भूतभव्यभवत्प्रभुः"
  },
  {
   "n": "78",
   "text": "भूतकृद्भूतभृद्भावो भूतात्मा भूतभावनः"
  },
  {
   "n": "79",
   "text": "पूतात्मा परमात्मा च मुक्तानां परमागतिः"
  },
  {
   "n": "80",
   "text": "अव्ययः पुरुषस्साक्षी क्षेत्रज्ञोऽक्षर एव च"
  },
  {
   "n": "81",
   "text": "योगो योगविदां नेता प्रधानपुरुषेश्वरः"
  },
  {
   "n": "82",
   "text": "नारसिंहवपुः श्रीमान् केशवः पुरुषोत्तमः"
  },
  {
   "n": "83",
   "text": "सर्वश्शर्वश्शिवस्स्थाणुर्भूतादिर्निधिरव्ययः"
  },
  {
   "n": "84",
   "text": "सम्भवो भावनो भर्ता प्रभवः प्रभुरीश्वरः"
  },
  {
   "n": "85",
   "text": "स्वयम्भूश्शम्भुरादित्यः पुष्कराक्षो महास्वनः"
  },
  {
   "n": "86",
   "text": "अनादिनिधनो धाता विधाता धातुरुत्तमः"
  },
  {
   "n": "87",
   "text": "अप्रमेयो हृषीकेशः पद्मनाभोऽमरप्रभुः"
  },
  {
   "n": "88",
   "text": "विश्वकर्मा मनुस्त्वष्टा स्थविष्ठः स्थविरो ध्रुवः"
  },
  {
   "n": "89",
   "text": "अग्राह्यश्शाश्वतः कृष्णो लोहिताक्षः प्रतर्दनः"
  },
  {
   "n": "90",
   "text": "प्रभूतस्त्रिककुब्धाम पवित्रं मङ्गलं परम्"
  },
  {
   "n": "91",
   "text": "ईशानः प्राणदः प्राणो ज्येष्ठः श्रेष्ठः प्रजापतिः"
  },
  {
   "n": "92",
   "text": "हिरण्यगर्भो भूगर्भो माधवो मधुसूदनः"
  },
  {
   "n": "93",
   "text": "ईश्वरो विक्रमी धन्वी मेधावी विक्रमः क्रमः"
  },
  {
   "n": "94",
   "text": "अनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्"
  },
  {
   "n": "95",
   "text": "सुरेशश्शरणं शर्म विश्वरेताः प्रजाभवः"
  },
  {
   "n": "96",
   "text": "अहस्संवत्सरो व्यालः प्रत्ययस्सर्वदर्शनः"
  },
  {
   "n": "97",
   "text": "अजस्सर्वेश्वरस्सिद्धस्सिद्धिस्सर्वादिरच्युतः"
  },
  {
   "n": "98",
   "text": "वृषाकपिरमेयात्मा सर्वयोगविनिस्सृतः"
  },
  {
   "n": "99",
   "text": "वसुर्वसुमनास्सत्यस्समात्मा सम्मितस्समः"
  },
  {
   "n": "100",
   "text": "अमोघः पुण्डरीकाक्षो वृषकर्मा वृषाकृतिः"
  },
  {
   "n": "101",
   "text": "रुद्रो बहुशिरा बभ्रुर्विश्वयोनिश्शुचिश्रवाः"
  },
  {
   "n": "102",
   "text": "अमृतश्शाश्वतस्स्थाणुर्वरारोहो महातपाः"
  },
  {
   "n": "103",
   "text": "सर्वगस्सर्वविद्भानुर्विष्वक्सेनो जनार्दनः"
  },
  {
   "n": "104",
   "text": "वेदो वेदविदव्यङ्गो वेदाङ्गो वेदवित्कविः"
  },
  {
   "n": "105",
   "text": "लोकाध्यक्षस्सुराध्यक्षो धर्माध्यक्षः कृताकृतः"
  },
  {
   "n": "106",
   "text": "चतुरात्मा चतुर्व्यूहश्चतुर्दम्ष्ट्रश्चतुर्भुजः"
  },
  {
   "n": "107",
   "text": "भ्राजिष्णुर्भोजनं भोक्ता सहिष्णुर्जगदादिजः"
  },
  {
   "n": "108",
   "text": "अनघो विजयो जेता विश्वयोनिः पुनर्वसुः"
  },
  {
   "n": "109",
   "text": "उपेन्द्रो वामनः प्रांशुरमोघश्शुचिरूर्जितः"
  },
  {
   "n": "110",
   "text": "अतीन्द्रस्सङ्ग्रहस्सर्गो धृतात्मा नियमो यमः"
  },
  {
   "n": "111",
   "text": "वेद्यो वैद्यस्सदायोगी वीरहा माधवो मधुः"
  },
  {
   "n": "112",
   "text": "अतीन्द्रियो महामायो महोत्साहो महाबलः"
  },
  {
   "n": "113",
   "text": "महाबुद्धिर्महावीर्यो महाशक्तिर्महाद्युतिः"
  },
  {
   "n": "114",
   "text": "अनिर्देश्यवपुः श्रीमानमेयात्मा महाद्रिधृत्"
  },
  {
   "n": "115",
   "text": "महेष्वासो महीभर्ता श्रीनिवासस्सतांगतिः"
  },
  {
   "n": "116",
   "text": "अनिरुद्धस्सुरानन्दो गोविन्दो गोविदांपतिः"
  },
  {
   "n": "117",
   "text": "मरीचिर्दमनो हंसस्सुपर्णो भुजगोत्तमः"
  },
  {
   "n": "118",
   "text": "हिरण्यनाभस्सुतपाः पद्मनाभः प्रजापतिः"
  },
  {
   "n": "119",
   "text": "अमृत्युस्सर्वदृक्सिंहस्सन्धाता सन्धिमान् स्थिरः"
  },
  {
   "n": "120",
   "text": "अजो दुर्मर्षणश्शास्ता विश्रुतात्मा सुरारिहा"
  },
  {
   "n": "121",
   "text": "गुरुर्गुरुतमो धाम सत्यस्सत्यपराक्रमः"
  },
  {
   "n": "122",
   "text": "निमिषोऽनिमिषस्स्रग्वी वाचस्पतिरुदारधीः"
  },
  {
   "n": "123",
   "text": "अग्रणीर्ग्रामणीः श्रीमान्न्यायो नेता समीरणः"
  },
  {
   "n": "124",
   "text": "सहस्रमूर्धा विश्वात्मा सहस्राक्षस्सहस्रपात्"
  },
  {
   "n": "125",
   "text": "आवर्तनो निवृत्तात्मा संवृतस्सम्प्रमर्दनः"
  },
  {
   "n": "126",
   "text": "अहस्संवर्तको वह्निरनिलो धरणीधरः"
  },
  {
   "n": "127",
   "text": "सुप्रसादः प्रसन्नात्मा विश्वसृड्विश्वभुग्विभुः"
  },
  {
   "n": "128",
   "text": "सत्कर्ता सत्कृतस्साधुर्जह्नुर्नारायणो नरः"
  },
  {
   "n": "129",
   "text": "असङ्ख्येयोऽप्रमेयात्मा विशिष्टश्शिष्टकृच्छुचिः"
  },
  {
   "n": "130",
   "text": "सिद्धार्थस्सिद्धसङ्कल्पस्सिद्धिदस्सिद्धिसाधनः"
  },
  {
   "n": "131",
   "text": "वृषाही वृषभो विष्णुर्वृषपर्वा वृषोदरः"
  },
  {
   "n": "132",
   "text": "वर्धनो वर्धमानश्च विविक्तः श्रुतिसागरः"
  },
  {
   "n": "133",
   "text": "सुभुजो दुर्धरो वाग्मी महेन्द्रो वसुदो वसुः"
  },
  {
   "n": "134",
   "text": "नैकरूपो बृहद्रूपः शिपिविष्टः प्रकाशनः"
  },
  {
   "n": "135",
   "text": "ओजस्तेजो द्युतिधरः प्रकाशात्मा प्रतापनः"
  },
  {
   "n": "136",
   "text": "ऋद्धस्स्पष्टाक्षरो मन्त्रश्चन्द्रांशुर्भास्करद्युतिः"
  },
  {
   "n": "137",
   "text": "अमृतांशूद्भवो भानुः शशबिन्दुस्सुरेश्वरः"
  },
  {
   "n": "138",
   "text": "औषधं जगतस्सेतुस्सत्यधर्मपराक्रमः"
  },
  {
   "n": "139",
   "text": "भूतभव्यभवन्नाथः पवनः पावनोऽनलः"
  },
  {
   "n": "140",
   "text": "कामहा कामकृत्कान्तः कामः कामप्रदः प्रभुः"
  },
  {
   "n": "141",
   "text": "युगादिकृद्युगावर्तो नैकमायो महाशनः"
  },
  {
   "n": "142",
   "text": "अदृश्यो व्यक्तरूपश्च सहस्रजिदनन्तजित्"
  },
  {
   "n": "143",
   "text": "इष्टोऽविशिष्टश्शिष्टेष्टः शिखण्डी नहुषो वृषः"
  },
  {
   "n": "144",
   "text": "क्रोधहा क्रोधकृत्कर्ता विश्वबाहुर्महीधरः"
  },
  {
   "n": "145",
   "text": "अच्युतः प्रथितः प्राणः प्राणदो वासवानुजः"
  },
  {
   "n": "146",
   "text": "अपांनिधिरधिष्ठानमप्रमत्तः प्रतिष्ठितः"
  },
  {
   "n": "147",
   "text": "स्कन्दः स्कन्दधरो धुर्यो वरदो वायुवाहनः"
  },
  {
   "n": "148",
   "text": "वासुदेवो बृहद्भानुरादिदेवः पुरन्दरः"
  },
  {
   "n": "149",
   "text": "अशोकस्तारणस्तारः शूरश्शौरिर्जनेश्वरः"
  },
  {
   "n": "150",
   "text": "अनुकूलश्शतावर्तः पद्मी पद्मनिभेक्षणः"
  },
  {
   "n": "151",
   "text": "पद्मनाभोऽरविन्दाक्षः पद्मगर्भश्शरीरभृत्"
  },
  {
   "n": "152",
   "text": "महर्धिरृद्धो वृद्धात्मा महाक्षो गरुडध्वजः"
  },
  {
   "n": "153",
   "text": "अतुलश्शरभो भीमस्समयज्ञो हविर्हरिः"
  },
  {
   "n": "154",
   "text": "सर्वलक्षणलक्षण्यो लक्ष्मीवान् समितिञ्जयः"
  },
  {
   "n": "155",
   "text": "विक्षरो रोहितो मार्गो हेतुर्दामोदरस्सहः"
  },
  {
   "n": "156",
   "text": "महीधरो महाभागो वेगवानमिताशनः"
  },
  {
   "n": "157",
   "text": "उद्भवः क्षोभणो देवः श्रीगर्भः परमेश्वरः"
  },
  {
   "n": "158",
   "text": "करणं कारणं कर्ता विकर्ता गहनो गुहः"
  },
  {
   "n": "159",
   "text": "व्यवसायो व्यवस्थानः संस्थानः स्थानदो ध्रुवः"
  },
  {
   "n": "160",
   "text": "परर्धिः परमस्पष्टस्तुष्टः पुष्टश्शुभेक्षणः"
  },
  {
   "n": "161",
   "text": "रामो विरामो विरजो मार्गो नेयो नयोऽनयः"
  },
  {
   "n": "162",
   "text": "वीरश्शक्तिमतां श्रेष्ठो धर्मो धर्मविदुत्तमः"
  },
  {
   "n": "163",
   "text": "वैकुण्ठः पुरुषः प्राणः प्राणदः प्रणवः पृथुः"
  },
  {
   "n": "164",
   "text": "हिरण्यगर्भश्शत्रुघ्नो व्याप्तो वायुरधोक्षजः"
  },
  {
   "n": "165",
   "text": "ऋतुस्सुदर्शनः कालः परमेष्ठी परिग्रहः"
  },
  {
   "n": "166",
   "text": "उग्रस्संवत्सरो दक्षो विश्रामो विश्वदक्षिणः"
  },
  {
   "n": "167",
   "text": "विस्तारस्स्थावरस्थाणुः प्रमाणं बीजमव्ययम्"
  },
  {
   "n": "168",
   "text": "अर्थोऽनर्थो महाकोशो महाभोगो महाधनः"
  },
  {
   "n": "169",
   "text": "अनिर्विण्णस्स्थविष्ठो भूर्धर्मयूपो महामखः"
  },
  {
   "n": "170",
   "text": "नक्षत्रनेमिर्नक्षत्री क्षमः क्षामस्समीहनः"
  },
  {
   "n": "171",
   "text": "यज्ञ इज्यो महेज्यश्च क्रतुस्सत्रं सतांगतिः"
  },
  {
   "n": "172",
   "text": "सर्वदर्शी विमुक्तात्मा सर्वज्ञो ज्ञानमुत्तमम्"
  },
  {
   "n": "173",
   "text": "सुव्रतस्सुमुखस्सूक्ष्मः सुघोषस्सुखदस्सुहृत्"
  },
  {
   "n": "174",
   "text": "मनोहरो जितक्रोधो वीरबाहुर्विदारणः"
  },
  {
   "n": "175",
   "text": "स्वापनस्स्ववशो व्यापी नैकात्मा नैककर्मकृत्"
  },
  {
   "n": "176",
   "text": "वत्सरो वत्सलो वत्सी रत्नगर्भो धनेश्वरः"
  },
  {
   "n": "177",
   "text": "धर्मगुब्धर्मकृद्धर्मी सदसत्क्षरमक्षरम्"
  },
  {
   "n": "178",
   "text": "अविज्ञाता सहस्रांशुर्विधाता कृतलक्षणः"
  },
  {
   "n": "179",
   "text": "गभस्तिनेमिस्सत्त्वस्थस्सिंहो भूतमहेश्वरः"
  },
  {
   "n": "180",
   "text": "आदिदेवो महादेवो देवेशो देवभृद्गुरुः"
  },
  {
   "n": "181",
   "text": "उत्तरो गोपतिर्गोप्ता ज्ञानगम्यः पुरातनः"
  },
  {
   "n": "182",
   "text": "शरीरभूतभृद्भोक्ता कपीन्द्रो भूरिदक्षिणः"
  },
  {
   "n": "183",
   "text": "सोमपोऽमृतपस्सोमः पुरुजित्पुरुसत्तमः"
  },
  {
   "n": "184",
   "text": "विनयो जयस्सत्यसन्धो दाशार्हस्सात्त्वताम्पतिः"
  },
  {
   "n": "185",
   "text": "जीवो विनयिता साक्षी मुकुन्दोऽमितविक्रमः"
  },
  {
   "n": "186",
   "text": "अम्भोनिधिरनन्तात्मा महोदधिशयोऽन्तकः"
  },
  {
   "n": "187",
   "text": "अजो महार्हस्स्वाभाव्यो जितामित्रः प्रमोदनः"
  },
  {
   "n": "188",
   "text": "आनन्दो नन्दनो नन्दस्सत्यधर्मा त्रिविक्रमः"
  },
  {
   "n": "189",
   "text": "महर्षिः कपिलाचार्यः कृतज्ञो मेदिनीपतिः"
  },
  {
   "n": "190",
   "text": "त्रिपदस्त्रिदशाध्यक्षो महाशृङ्गः कृतान्तकृत्"
  },
  {
   "n": "191",
   "text": "महावराहो गोविन्दस्सुषेणः कनकाङ्गदी"
  },
  {
   "n": "192",
   "text": "गुह्यो गभीरो गहनो गुप्तश्चक्रगदाधरः"
  },
  {
   "n": "193",
   "text": "वेधास्स्वाङ्गोऽजितः कृष्णो दृढस्सङ्कर्षणोऽच्युतः"
  },
  {
   "n": "194",
   "text": "वरुणो वारुणो वृक्षः पुष्कराक्षो महामनाः"
  },
  {
   "n": "195",
   "text": "भगवान् भगहाऽऽनन्दी वनमाली हलायुधः"
  },
  {
   "n": "196",
   "text": "आदित्यो ज्योतिरादित्यस्सहिष्णुर्गतिसत्तमः"
  },
  {
   "n": "197",
   "text": "सुधन्वा खण्डपरशुर्दारुणो द्रविणप्रदः"
  },
  {
   "n": "198",
   "text": "दिविस्पृक्सर्वदृग्व्यासो वाचस्पतिरयोनिजः"
  },
  {
   "n": "199",
   "text": "त्रिसामा सामगस्साम निर्वाणं भेषजं भिषक्"
  },
  {
   "n": "200",
   "text": "सन्न्यासकृच्छमश्शान्तो निष्ठा शान्तिः परायणम्"
  },
  {
   "n": "201",
   "text": "शुभाङ्गश्शान्तिदस्स्रष्टा कुमुदः कुवलेशयः"
  },
  {
   "n": "202",
   "text": "गोहितो गोपतिर्गोप्ता वृषभाक्षो वृषप्रियः"
  },
  {
   "n": "203",
   "text": "अनिवर्ती निवृत्तात्मा सङ्क्षेप्ता क्षेमकृच्छिवः"
  },
  {
   "n": "204",
   "text": "श्रीवत्सवक्षाः श्रीवासः श्रीपतिः श्रीमतांवरः"
  },
  {
   "n": "205",
   "text": "श्रीदः श्रीशः श्रीनिवासः श्रीनिधिः श्रीविभावनः"
  },
  {
   "n": "206",
   "text": "श्रीधरः श्रीकरः श्रेयः श्रीमान् लोकत्रयाश्रयः"
  },
  {
   "n": "207",
   "text": "स्वक्षस्स्वङ्गश्शतानन्दो नन्दिर्ज्योतिर्गणेश्वरः"
  },
  {
   "n": "208",
   "text": "विजितात्मा विधेयात्मा सत्कीर्तिश्छिन्नसंशयः"
  },
  {
   "n": "209",
   "text": "उदीर्णस्सर्वतश्चक्षुरनीशश्शाश्वतस्थिरः"
  },
  {
   "n": "210",
   "text": "भूशयो भूषणो भूतिर्विशोकश्शोकनाशनः"
  },
  {
   "n": "211",
   "text": "अर्चिष्मानर्चितः कुम्भो विशुद्धात्मा विशोधनः"
  },
  {
   "n": "212",
   "text": "अनिरुद्धोऽप्रतिरथः प्रद्युम्नोऽमितविक्रमः"
  },
  {
   "n": "213",
   "text": "कालनेमिनिहा वीरश्शौरिश्शूरजनेश्वरः"
  },
  {
   "n": "214",
   "text": "त्रिलोकात्मा त्रिलोकेशः केशवः केशिहा हरिः"
  },
  {
   "n": "215",
   "text": "कामदेवः कामपालः कामी कान्तः कृतागमः"
  },
  {
   "n": "216",
   "text": "अनिर्देश्यवपुर्विष्णुर्वीरोऽनन्तो धनञ्जयः"
  },
  {
   "n": "217",
   "text": "ब्रह्मण्यो ब्रह्मकृद्ब्रह्मा ब्रह्म ब्रह्मविवर्धनः"
  },
  {
   "n": "218",
   "text": "ब्रह्मविद्ब्राह्मणो ब्रह्मी ब्रह्मज्ञो ब्राह्मणप्रियः"
  },
  {
   "n": "219",
   "text": "महाक्रमो महाकर्मा महातेजा महोरगः"
  },
  {
   "n": "220",
   "text": "महाक्रतुर्महायज्वा महायज्ञो महाहविः"
  },
  {
   "n": "221",
   "text": "स्तव्यस्स्तवप्रियस्स्तोत्रम् स्तुतिस्स्तोता रणप्रियः"
  },
  {
   "n": "222",
   "text": "पूर्णः पूरयिता पुण्यः पुण्यकीर्तिरनामयः"
  },
  {
   "n": "223",
   "text": "मनोजवस्तीर्थकरो वसुरेता वसुप्रदः"
  },
  {
   "n": "224",
   "text": "वसुप्रदो वासुदेवो वसुर्वसुमना हविः"
  },
  {
   "n": "225",
   "text": "सद्गतिस्सत्कृतिस्सत्ता सद्भूतिस्सत्परायणः"
  },
  {
   "n": "226",
   "text": "शूरसेनो यदुश्रेष्ठस्सन्निवासस्सुयामुनः"
  },
  {
   "n": "227",
   "text": "भूतावासो वासुदेवः सर्वासुनिलयोऽनलः"
  },
  {
   "n": "228",
   "text": "दर्पहा दर्पदोऽदृप्तो दुर्धरोऽथापराजितः"
  },
  {
   "n": "229",
   "text": "विश्वमूर्तिर्महामूर्तिर्दीप्तमूर्तिरमूर्तिमान्"
  },
  {
   "n": "230",
   "text": "अनेकमूर्तिरव्यक्तश्शतमूर्तिश्शताननः"
  },
  {
   "n": "231",
   "text": "एको नैकस्स्तवः कः किं यत्तत्पदमनुत्तमम्"
  },
  {
   "n": "232",
   "text": "लोकबन्धुर्लोकनाथो माधवो भक्तवत्सलः"
  },
  {
   "n": "233",
   "text": "सुवर्णवर्णो हेमाङ्गो वराङ्गश्चन्दनाङ्गदी"
  },
  {
   "n": "234",
   "text": "वीरहा विषमश्शून्यो घृताशीरचलश्चलः"
  },
  {
   "n": "235",
   "text": "अमानी मानदो मान्यो लोकस्वामी त्रिलोकधृत्"
  },
  {
   "n": "236",
   "text": "सुमेधा मेधजो धन्यस्सत्यमेधा धराधरः"
  },
  {
   "n": "237",
   "text": "तेजोवृषो द्युतिधरस्सर्वशस्त्रभृतां वरः"
  },
  {
   "n": "238",
   "text": "प्रग्रहो निग्रहो व्यग्रो नैकशृङ्गो गदाग्रजः"
  },
  {
   "n": "239",
   "text": "चतुर्मूर्तिश्चतुर्बाहुश्चतुर्व्यूहश्चतुर्गतिः"
  },
  {
   "n": "240",
   "text": "चतुरात्मा चतुर्भावश्चतुर्वेदविदेकपात्"
  },
  {
   "n": "241",
   "text": "समावर्तोऽनिवृत्तात्मा दुर्जयो दुरतिक्रमः"
  },
  {
   "n": "242",
   "text": "दुर्लभो दुर्गमो दुर्गो दुरावासो दुरारिहा"
  },
  {
   "n": "243",
   "text": "शुभाङ्गो लोकसारङ्गस्सुतन्तुस्तन्तुवर्धनः"
  },
  {
   "n": "244",
   "text": "इन्द्रकर्मा महाकर्मा कृतकर्मा कृतागमः"
  },
  {
   "n": "245",
   "text": "उद्भवस्सुन्दरस्सुन्दो रत्ननाभस्सुलोचनः"
  },
  {
   "n": "246",
   "text": "अर्को वाजसनश्शृङ्गी जयन्तस्सर्वविज्जयी"
  },
  {
   "n": "247",
   "text": "सुवर्णबिन्दुरक्षोभ्यस्सर्ववागीश्वरेश्वरः"
  },
  {
   "n": "248",
   "text": "महाह्रदो महागर्तो महाभूतो महानिधिः"
  },
  {
   "n": "249",
   "text": "कुमुदः कुन्दरः कुन्दः पर्जन्यः पावनोऽनिलः"
  },
  {
   "n": "250",
   "text": "अमृतांशोऽमृतवपुस्सर्वज्ञस्सर्वतोमुखः"
  },
  {
   "n": "251",
   "text": "सुलभस्सुव्रतस्सिद्धः शत्रुजिच्छत्रुतापनः"
  },
  {
   "n": "252",
   "text": "न्यग्रोधोदुम्बरोऽश्वत्थश्चाणूरान्ध्रनिषूदनः"
  },
  {
   "n": "253",
   "text": "सहस्रार्चिस्सप्तजिह्वस्सप्तैधास्सप्तवाहनः"
  },
  {
   "n": "254",
   "text": "अमूर्तिरनघोऽचिन्त्यो भयकृद्भयनाशनः"
  },
  {
   "n": "255",
   "text": "अणुर्बृहत्कृशः स्थूलो गुणभृन्निर्गुणो महान्"
  },
  {
   "n": "256",
   "text": "अधृतः स्वधृतस्स्वास्थ्यः प्राग्वंशो वंशवर्धनः"
  },
  {
   "n": "257",
   "text": "भारभृत्कथितो योगी योगीशस्सर्वकामदः"
  },
  {
   "n": "258",
   "text": "आश्रमः श्रमणः क्षामः सुपर्णो वायुवाहनः"
  },
  {
   "n": "259",
   "text": "धनुर्धरो धनुर्वेदो दण्डो दमयिता दमः"
  },
  {
   "n": "260",
   "text": "अपराजितस्सर्वसहो नियन्ता नियमो यमः"
  },
  {
   "n": "261",
   "text": "सत्त्ववान् सात्त्विकस्सत्यस्सत्यधर्मपरायणः"
  },
  {
   "n": "262",
   "text": "अभिप्रायः प्रियार्होऽर्हः प्रियकृत्प्रीतिवर्धनः"
  },
  {
   "n": "263",
   "text": "विहायसगतिर्ज्योतिस्सुरुचिर्हुतभुग्विभुः"
  },
  {
   "n": "264",
   "text": "रविर्विलोचनस्सूर्यस्सविता रविलोचनः"
  },
  {
   "n": "265",
   "text": "अनन्तो हुतभुग्भोक्ता सुखदो नैकजोऽग्रजः"
  },
  {
   "n": "266",
   "text": "अनिर्विण्णस्सदामर्षी लोकाधिष्ठानमद्भुतः"
  },
  {
   "n": "267",
   "text": "सनात्सनातनतमः कपिलः कपिरव्ययः"
  },
  {
   "n": "268",
   "text": "स्वस्तिदस्स्वस्तिकृत्स्वस्ति स्वस्तिभुक्स्वस्तिदक्षिणः"
  },
  {
   "n": "269",
   "text": "अरौद्रः कुण्डली चक्री विक्रम्यूर्जितशासनः"
  },
  {
   "n": "270",
   "text": "शब्दातिगश्शब्दसहः शिशिरश्शर्वरीकरः"
  },
  {
   "n": "271",
   "text": "अक्रूरः पेशलो दक्षो दक्षिणः क्षमिणांवरः"
  },
  {
   "n": "272",
   "text": "विद्वत्तमो वीतभयः पुण्यश्रवणकीर्तनः"
  },
  {
   "n": "273",
   "text": "उत्तारणो दुष्कृतिहा पुण्यो दुस्स्वप्ननाशनः"
  },
  {
   "n": "274",
   "text": "वीरहा रक्षणस्सन्तो जीवनं पर्यवस्थितः"
  },
  {
   "n": "275",
   "text": "अनन्तरूपोऽनन्तश्रीर्जितमन्युर्भयापहः"
  },
  {
   "n": "276",
   "text": "चतुरश्रो गभीरात्मा विदिशो व्यादिशो दिशः"
  },
  {
   "n": "277",
   "text": "अनादिर्भूर्भुवो लक्ष्मीस्सुवीरो रुचिराङ्गदः"
  },
  {
   "n": "278",
   "text": "जननो जनजन्मादिर्भीमो भीमपराक्रमः"
  },
  {
   "n": "279",
   "text": "आधारनिलयो धाता पुष्पहासः प्रजागरः"
  },
  {
   "n": "280",
   "text": "ऊर्ध्वगस्सत्पथाचारः प्राणदः प्रणवः पणः"
  },
  {
   "n": "281",
   "text": "प्रमाणं प्राणनिलयः प्राणभृत्प्राणजीवनः"
  },
  {
   "n": "282",
   "text": "तत्त्वं तत्त्वविदेकात्मा जन्ममृत्युजरातिगः"
  },
  {
   "n": "283",
   "text": "भूर्भुवस्स्वस्तरुस्तारस्सविता प्रपितामहः"
  },
  {
   "n": "284",
   "text": "यज्ञो यज्ञपतिर्यज्वा यज्ञाङ्गो यज्ञवाहनः"
  },
  {
   "n": "285",
   "text": "यज्ञभृद्यज्ञकृद्यज्ञी यज्ञभुग्यज्ञसाधनः"
  },
  {
   "n": "286",
   "text": "यज्ञान्तकृद्यज्ञगुह्यमन्नमन्नाद एव च"
  },
  {
   "n": "287",
   "text": "आत्मयोनिस्स्वयञ्जातो वैखानस्सामगायनः"
  },
  {
   "n": "288",
   "text": "देवकीनन्दनस्स्रष्टा क्षितीशः पापनाशनः"
  },
  {
   "n": "289",
   "text": "शङ्खभृन्नन्दकी चक्री शार्ङ्गधन्वा गदाधरः"
  },
  {
   "n": "290",
   "text": "रथाङ्गपाणिरक्षोभ्यस्सर्वप्रहरणायुधः"
  },
  {
   "n": "291",
   "text": "श्रीसर्वप्रहरणायुध ॐ नम इति"
  },
  {
   "n": "292",
   "text": "वनमाली गदी शार्ङ्गी शङ्खी चक्री च नन्दकी"
  },
  {
   "n": "293",
   "text": "श्रीमान्नारायणो विष्णुर्वासुदेवोऽभिरक्षतु"
  },
  {
   "n": "294",
   "text": "श्री वासुदेवोऽभिरक्षतु ॐ नम इति"
  },
  {
   "n": "295",
   "text": "उत्तरपीठिका"
  },
  {
   "n": "296",
   "text": "श्री भीष्म उवाच"
  },
  {
   "n": "297",
   "text": "इतीदं कीर्तनीयस्य केशवस्य महात्मनः"
  },
  {
   "n": "298",
   "text": "नाम्नां सहस्रं दिव्यानामशेषेण प्रकीर्तितम्"
  },
  {
   "n": "299",
   "text": "य इदं शृणुयान्नित्यं यश्चापि परिकीर्तयेत्"
  },
  {
   "n": "300",
   "text": "नाऽशुभं प्राप्नुयात्किञ्चित्सोऽमुत्रेह च मानवः"
  },
  {
   "n": "301",
   "text": "वेदान्तगो ब्राह्मणस्स्यात् क्षत्रियो विजयी भवेत्"
  },
  {
   "n": "302",
   "text": "वैश्यो धनसमृद्धस्स्याच्छूद्रस्सुखमवाप्नुयात्"
  },
  {
   "n": "303",
   "text": "धर्मार्थी प्राप्नुयाद्धर्ममर्थार्थी चार्थमाप्नुयात्"
  },
  {
   "n": "304",
   "text": "कामानवाप्नुयात्कामी प्रजार्थी चाप्नुयात्प्रजाः"
  },
  {
   "n": "305",
   "text": "भक्तिमान् यस्सदोत्थाय शुचिस्तद्गतमानसः"
  },
  {
   "n": "306",
   "text": "सहस्रं वासुदेवस्य नाम्नामेतत्प्रकीर्तयेत्"
  },
  {
   "n": "307",
   "text": "यशः प्राप्नोति विपुलं याति प्राधान्यमेव च"
  },
  {
   "n": "308",
   "text": "अचलां श्रियमाप्नोति श्रेयः प्राप्नोत्यनुत्तमम्"
  },
  {
   "n": "309",
   "text": "न भयं क्वचिदाप्नोति वीर्यं तेजश्च विन्दति"
  },
  {
   "n": "310",
   "text": "भवत्यरोगो द्युतिमान्बलरूपगुणान्वितः"
  },
  {
   "n": "311",
   "text": "रोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात्"
  },
  {
   "n": "312",
   "text": "भयान्मुच्येत भीतस्तु मुच्येतापन्न आपदः"
  },
  {
   "n": "313",
   "text": "दुर्गाण्यतितरत्याशु पुरुषः पुरुषोत्तमम्"
  },
  {
   "n": "314",
   "text": "स्तुवन्नामसहस्रेण नित्यं भक्तिसमन्वितः"
  },
  {
   "n": "315",
   "text": "वासुदेवाश्रयो मर्त्यो वासुदेवपरायणः"
  },
  {
   "n": "316",
   "text": "सर्वपापविशुद्धात्मा याति ब्रह्म सनातनम्"
  },
  {
   "n": "317",
   "text": "न वासुदेवभक्तानामशुभं विद्यते क्वचित्"
  },
  {
   "n": "318",
   "text": "जन्ममृत्युजराव्याधिभयं नैवोपजायते"
  },
  {
   "n": "319",
   "text": "इमं स्तवमधीयानः श्रद्धाभक्तिसमन्वितः"
  },
  {
   "n": "320",
   "text": "युज्येतात्मा सुखक्षान्ति श्रीधृतिस्मृतिकीर्तिभिः"
  },
  {
   "n": "321",
   "text": "न क्रोधो न च मात्सर्यं न लोभो नाशुभामतिः"
  },
  {
   "n": "322",
   "text": "भवन्ति कृत पुण्यानां भक्तानां पुरुषोत्तमे"
  },
  {
   "n": "323",
   "text": "द्यौस्सचन्द्रार्कनक्षत्रं खं दिशो भूर्महोदधिः"
  },
  {
   "n": "324",
   "text": "वासुदेवस्य वीर्येण विधृतानि महात्मनः"
  },
  {
   "n": "325",
   "text": "स सुरासुरगन्धर्वं सयक्षोरगराक्षसम्"
  },
  {
   "n": "326",
   "text": "जगद्वशे वर्ततेदं कृष्णस्य सचराचरम्"
  },
  {
   "n": "327",
   "text": "इन्द्रियाणि मनो बुद्धिस्सत्त्वं तेजो बलं धृतिः"
  },
  {
   "n": "328",
   "text": "वासुदेवात्मकान्याहुः क्षेत्रं क्षेत्रज्ञ एव च"
  },
  {
   "n": "329",
   "text": "सर्वागमानामाचारः प्रथमं परिकल्पितः"
  },
  {
   "n": "330",
   "text": "आचारप्रभवो धर्मो धर्मस्य प्रभुरच्युतः"
  },
  {
   "n": "331",
   "text": "ऋषयः पितरो देवा महाभूतानि धातवः"
  },
  {
   "n": "332",
   "text": "जङ्गमाजङ्गमं चेदं जगन्नारायणोद्भवम्"
  },
  {
   "n": "333",
   "text": "योगो ज्ञानं तथा साङ्ख्यं विद्याश्शिल्पादि कर्म च"
  },
  {
   "n": "334",
   "text": "वेदाश्शास्त्राणि विज्ञानमेतत्सर्वं जनार्दनात्"
  },
  {
   "n": "335",
   "text": "एको विष्णुर्महद्भूतं पृथग्भूतान्यनेकशः"
  },
  {
   "n": "336",
   "text": "त्रीन्लोकान्व्याप्य भूतात्मा भुङ्क्ते विश्वभुगव्ययः"
  },
  {
   "n": "337",
   "text": "इमं स्तवं भगवतो विष्णोर्व्यासेन कीर्तितम्"
  },
  {
   "n": "338",
   "text": "पठेद्य इच्छेत्पुरुषः श्रेयः प्राप्तुं सुखानि च"
  },
  {
   "n": "339",
   "text": "विश्वेश्वरमजं देवं जगतः प्रभुमव्ययम्"
  },
  {
   "n": "340",
   "text": "भजन्ति ये पुष्कराक्षं न ते यान्ति पराभवम्"
  },
  {
   "n": "341",
   "text": "न ते यान्ति पराभवम् ॐ नम इति"
  },
  {
   "n": "342",
   "text": "अर्जुन उवाच"
  },
  {
   "n": "343",
   "text": "पद्मपत्रविशालाक्ष पद्मनाभ सुरोत्तम"
  },
  {
   "n": "344",
   "text": "भक्तानामनुरक्तानां त्राता भव जनार्दन"
  },
  {
   "n": "345",
   "text": "श्री भगवानुवाच"
  },
  {
   "n": "346",
   "text": "यो मां नामसहस्रेण स्तोतुमिच्छति पाण्डव"
  },
  {
   "n": "347",
   "text": "सोऽहमेकेन श्लोकेन स्तुत एव न संशयः"
  },
  {
   "n": "348",
   "text": "स्तुत एव न संशय ॐ नम इति"
  },
  {
   "n": "349",
   "text": "वासनाद्वासुदेवस्य वासितं ते जगत्त्रयम्"
  },
  {
   "n": "350",
   "text": "सर्वभूतनिवासोऽसि वासुदेव नमोऽस्तु ते"
  },
  {
   "n": "351",
   "text": "श्री वासुदेव नमोऽस्तुत ॐ नम इति"
  },
  {
   "n": "352",
   "text": "पार्वत्युवाच"
  },
  {
   "n": "353",
   "text": "केनोपायेन लघुना विष्णोर्नामसहस्रकम्"
  },
  {
   "n": "354",
   "text": "पठ्यते पण्डितैर्नित्यं श्रोतुमिच्छाम्यहं प्रभो"
  },
  {
   "n": "355",
   "text": "श्रीराम राम रामेति रमे रामे मनोरमे"
  },
  {
   "n": "356",
   "text": "सहस्रनाम तत्तुल्यं राम नाम वरानने"
  },
  {
   "n": "357",
   "text": "श्रीरामनाम वरानन ॐ नम इति"
  },
  {
   "n": "358",
   "text": "ब्रह्मोवाच"
  },
  {
   "n": "359",
   "text": "नमोऽस्त्वनन्ताय सहस्रमूर्तये"
  },
  {
   "n": "360",
   "text": "सहस्रपादाक्षिशिरोरुबाहवे"
  },
  {
   "n": "361",
   "text": "सहस्रनाम्ने पुरुषाय शाश्वते"
  },
  {
   "n": "362",
   "text": "सहस्रकोटीयुगधारिणे नमः"
  },
  {
   "n": "363",
   "text": "सहस्रकोटीयुगधारिणे ॐ नम इति"
  },
  {
   "n": "364",
   "text": "यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः"
  },
  {
   "n": "365",
   "text": "तत्र श्रीर्विजयो भूतिर्ध्रुवा नीतिर्मतिर्मम"
  },
  {
   "n": "366",
   "text": "श्री भगवानुवाच"
  },
  {
   "n": "367",
   "text": "अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते"
  },
  {
   "n": "368",
   "text": "तेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम्"
  },
  {
   "n": "369",
   "text": "परित्राणाय साधूनां विनाशाय च दुष्कृताम्"
  },
  {
   "n": "370",
   "text": "धर्मसंस्थापनार्थाय सम्भवामि युगे युगे"
  },
  {
   "n": "371",
   "text": "आर्ता विषण्णाश्शिथिलाश्च भीताः"
  },
  {
   "n": "372",
   "text": "घोरेषु च व्याधिषु वर्तमानाः"
  },
  {
   "n": "373",
   "text": "सङ्कीर्त्य नारायणशब्दमात्रं"
  },
  {
   "n": "374",
   "text": "विमुक्तदुःखास्सुखिनो भवन्ति"
  },
  {
   "n": "375",
   "text": "यदक्षर पदभ्रष्टं मात्राहीनं तु यद्भवेत्"
  },
  {
   "n": "376",
   "text": "तत्सर्वं क्षम्यतां देव नारायण नमोऽस्तु ते"
  },
  {
   "n": "377",
   "text": "कायेन वाचा मनसेन्द्रियैर्वा"
  },
  {
   "n": "378",
   "text": "बुद्ध्यात्मना वा प्रकृतेस्स्वभावात्"
  },
  {
   "n": "379",
   "text": "करोमि यद्यत्सकलं परस्मै"
  },
  {
   "n": "380",
   "text": "नारायणायेति समर्पयामि"
  },
  {
   "n": "381",
   "text": "इति श्रीविष्णुसहस्रनाम स्तोत्रम्"
  },
  {
   "n": "382",
   "text": "बहुत सुंदर हैं इसे डाउनलोड पीडिएफ मै कैसे करे मार्ग दर्शन करें अथवा इमेल करें"
  },
  {
   "n": "383",
   "text": "बडी कृपा होगी"
  },
  {
   "n": "384",
   "text": "→ → श्री विष्णु सहस्रनाम स्तोत्र – उत्तरपीठिक"
  },
  {
   "n": "385",
   "text": "उत्तरन्यासः"
  },
  {
   "n": "386",
   "text": "श्री भीष्म उवाच-"
  },
  {
   "n": "387",
   "text": "नाशुभं प्राप्नुयात्किञ्चित्सोऽमुत्रेह च मानवः"
  },
  {
   "n": "388",
   "text": "वेदान्तगो ब्राह्मणः स्यात्क्षत्रियो विजयी भवेत्"
  },
  {
   "n": "389",
   "text": "वैश्यो धनसमृद्धः स्याच्छूद्रः सुखमवाप्नुयात्"
  },
  {
   "n": "390",
   "text": "कामानवाप्नुयात्कामी प्रजार्थी चाप्नुयात्प्रजाम्"
  },
  {
   "n": "391",
   "text": "भक्तिमान् यः सदोत्थाय शुचिस्तद्गतमानसः"
  },
  {
   "n": "392",
   "text": "यशः प्राप्नोति विपुलं ज्ञातिप्राधान्यमेव च"
  },
  {
   "n": "393",
   "text": "युज्येतात्मसुखक्षान्तिश्रीधृतिस्मृतिकीर्तिभिः"
  },
  {
   "n": "394",
   "text": "न क्रोधो न च मात्सर्यं न लोभो नाशुभा मतिः"
  },
  {
   "n": "395",
   "text": "द्यौः सचन्द्रार्कनक्षत्रा खं दिशो भूर्महोदधिः"
  },
  {
   "n": "396",
   "text": "ससुरासुरगन्धर्वं सयक्षोरगराक्षसम्"
  },
  {
   "n": "397",
   "text": "इन्द्रियाणि मनो बुद्धिः सत्त्वं तेजो बलं धृतिः"
  },
  {
   "n": "398",
   "text": "सर्वागमानामाचारः प्रथमं परिकल्पते"
  },
  {
   "n": "399",
   "text": "योगो ज्ञानं तथा साङ्ख्यं विद्याः शिल्पादि कर्म च"
  },
  {
   "n": "400",
   "text": "वेदाः शास्त्राणि विज्ञानमेतत्सर्वं जनार्दनात्"
  },
  {
   "n": "401",
   "text": "त्रींल्लोकान्व्याप्य भूतात्मा भुङ्क्ते विश्वभुगव्ययः"
  },
  {
   "n": "402",
   "text": "अर्जुन उवाच-"
  },
  {
   "n": "403",
   "text": "श्रीभगवानुवाच-"
  },
  {
   "n": "404",
   "text": "सोहऽमेकेन श्लोकेन स्तुत एव न संशयः"
  },
  {
   "n": "405",
   "text": "वासनाद्वासुदेवस्य वासितं भुवनत्रयम्"
  },
  {
   "n": "406",
   "text": "पार्वत्युवाच-"
  },
  {
   "n": "407",
   "text": "ब्रह्मोवाच-"
  },
  {
   "n": "408",
   "text": "नमोऽस्त्वनन्ताय सहस्रमूर्तये सहस्रपादाक्षिशिरोरुबाहवे"
  },
  {
   "n": "409",
   "text": "सहस्रनाम्ने पुरुषाय शाश्वते सहस्रकोटी युगधारिणे नमः"
  },
  {
   "n": "410",
   "text": "सहस्रकोटी युगधारिणे ॐ नम इति"
  },
  {
   "n": "411",
   "text": "श्रीभगवानुवाच-"
  },
  {
   "n": "412",
   "text": "आर्ताः विषण्णाः शिथिलाश्च भीताः घोरेषु च व्याधिषु वर्तमानाः"
  },
  {
   "n": "413",
   "text": "सङ्कीर्त्य नारायणशब्दमात्रं विमुक्तदुःखाः सुखिनो भवन्तु"
  },
  {
   "n": "414",
   "text": "कायेन वाचा मनसेन्द्रियैर्वा बुद्ध्यात्मना वा प्रकृतिस्वभावात्"
  },
  {
   "n": "415",
   "text": "करोमि यद्यत् सकलं परस्मै नारायणायेति समर्पयामि"
  },
  {
   "n": "416",
   "text": "इति श्रीविष्णोर्दिव्यसहस्रनामस्तोत्रं सम्पूर्णम्"
  }
 ]
}