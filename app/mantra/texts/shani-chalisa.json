{
 "slug": "shani-chalisa",
 "verses": [
  {
   "n": "1",
   "text": "जय गणेश गिरिजा सुवन, मंगल करण कृपाल"
  },
  {
   "n": "2",
   "text": "दीनन के दुख दूर करि, कीजै नाथ निहाल"
  },
  {
   "n": "3",
   "text": "जय जय श्री शनिदेव प्रभु, सुनहु विनय महाराज"
  },
  {
   "n": "4",
   "text": "करहु कृपा हे रवि तनय, राखहु जन की लाज"
  },
  {
   "n": "5",
   "text": "जयति जयति शनिदेव दयाला"
  },
  {
   "n": "6",
   "text": "करत सदा भक्तन प्रतिपाला"
  },
  {
   "n": "7",
   "text": "चारि भुजा, तनु श्याम विराजै"
  },
  {
   "n": "8",
   "text": "माथे रतन मुकुट छबि छाजै"
  },
  {
   "n": "9",
   "text": "परम विशाल मनोहर भाला"
  },
  {
   "n": "10",
   "text": "टेढ़ी दृष्टि भृकुटि विकराला"
  },
  {
   "n": "11",
   "text": "कुण्डल श्रवण चमाचम चमके"
  },
  {
   "n": "12",
   "text": "हिय माल मुक्तन मणि दमके"
  },
  {
   "n": "13",
   "text": "कर में गदा त्रिशूल कुठारा"
  },
  {
   "n": "14",
   "text": "पल बिच करैं अरिहिं संहारा"
  },
  {
   "n": "15",
   "text": "पिंगल, कृष्णों, छाया नन्दन"
  },
  {
   "n": "16",
   "text": "यम, कोणस्थ, रौद्र, दुखभंजन"
  },
  {
   "n": "17",
   "text": "सौरी, मन्द, शनी, दश नामा"
  },
  {
   "n": "18",
   "text": "भानु पुत्र पूजहिं सब कामा"
  },
  {
   "n": "19",
   "text": "जा पर प्रभु प्रसन्न ह्वैं जाहीं"
  },
  {
   "n": "20",
   "text": "रंकहुँ राव करैं क्षण माहीं"
  },
  {
   "n": "21",
   "text": "पर्वतहू तृण होई निहारत"
  },
  {
   "n": "22",
   "text": "तृणहू को पर्वत करि डारत"
  },
  {
   "n": "23",
   "text": "राज मिलत बन रामहिं दीन्हयो"
  },
  {
   "n": "24",
   "text": "कैकेइहुँ की मति हरि लीन्हयो"
  },
  {
   "n": "25",
   "text": "बनहूँ में मृग कपट दिखाई"
  },
  {
   "n": "26",
   "text": "मातु जानकी गई चुराई"
  },
  {
   "n": "27",
   "text": "लखनहिं शक्ति विकल करिडारा"
  },
  {
   "n": "28",
   "text": "मचिगा दल में हाहाकारा"
  },
  {
   "n": "29",
   "text": "रावण की गतिमति बौराई"
  },
  {
   "n": "30",
   "text": "रामचन्द्र सों बैर बढ़ाई"
  },
  {
   "n": "31",
   "text": "दियो कीट करि कंचन लंका"
  },
  {
   "n": "32",
   "text": "बजि बजरंग बीर की डंका"
  },
  {
   "n": "33",
   "text": "नृप विक्रम पर तुहि पगु धारा"
  },
  {
   "n": "34",
   "text": "चित्र मयूर निगलि गै हारा"
  },
  {
   "n": "35",
   "text": "हार नौलखा लाग्यो चोरी"
  },
  {
   "n": "36",
   "text": "हाथ पैर डरवाय तोरी"
  },
  {
   "n": "37",
   "text": "भारी दशा निकृष्ट दिखायो"
  },
  {
   "n": "38",
   "text": "तेलिहिं घर कोल्हू चलवायो"
  },
  {
   "n": "39",
   "text": "विनय राग दीपक महं कीन्हयों"
  },
  {
   "n": "40",
   "text": "तब प्रसन्न प्रभु ह्वै सुख दीन्हयों"
  },
  {
   "n": "41",
   "text": "हरिश्चन्द्र नृप नारि बिकानी"
  },
  {
   "n": "42",
   "text": "आपहुं भरे डोम घर पानी"
  },
  {
   "n": "43",
   "text": "तैसे नल पर दशा सिरानी"
  },
  {
   "n": "44",
   "text": "भूंजीमीन कूद गई पानी"
  },
  {
   "n": "45",
   "text": "श्री शंकरहिं गह्यो जब जाई"
  },
  {
   "n": "46",
   "text": "पारवती को सती कराई"
  },
  {
   "n": "47",
   "text": "तनिक विलोकत ही करि रीसा"
  },
  {
   "n": "48",
   "text": "नभ उड़ि गयो गौरिसुत सीसा"
  },
  {
   "n": "49",
   "text": "पाण्डव पर भै दशा तुम्हारी"
  },
  {
   "n": "50",
   "text": "बची द्रौपदी होति उघारी"
  },
  {
   "n": "51",
   "text": "कौरव के भी गति मति मारयो"
  },
  {
   "n": "52",
   "text": "युद्ध महाभारत करि डारयो"
  },
  {
   "n": "53",
   "text": "रवि कहँ मुख महँ धरि तत्काला"
  },
  {
   "n": "54",
   "text": "लेकर कूदि परयो पाताला"
  },
  {
   "n": "55",
   "text": "शेष देवलखि विनती लाई"
  },
  {
   "n": "56",
   "text": "रवि को मुख ते दियो छुड़ाई"
  },
  {
   "n": "57",
   "text": "वाहन प्रभु के सात सजाना"
  },
  {
   "n": "58",
   "text": "जग दिग्गज गर्दभ मृग स्वाना"
  },
  {
   "n": "59",
   "text": "जम्बुक सिंह आदि नख धारी"
  },
  {
   "n": "60",
   "text": "सो फल ज्योतिष कहत पुकारी"
  },
  {
   "n": "61",
   "text": "गज वाहन लक्ष्मी गृह आवैं"
  },
  {
   "n": "62",
   "text": "हय ते सुख सम्पति उपजावैं"
  },
  {
   "n": "63",
   "text": "गर्दभ हानि करै बहु काजा"
  },
  {
   "n": "64",
   "text": "सिंह सिद्धकर राज समाजा"
  },
  {
   "n": "65",
   "text": "जम्बुक बुद्धि नष्ट कर डारै"
  },
  {
   "n": "66",
   "text": "मृग दे कष्ट प्राण संहारै"
  },
  {
   "n": "67",
   "text": "जब आवहिं प्रभु स्वान सवारी"
  },
  {
   "n": "68",
   "text": "चोरी आदि होय डर भारी"
  },
  {
   "n": "69",
   "text": "तैसहि चारि चरण यह नामा"
  },
  {
   "n": "70",
   "text": "स्वर्ण लौह चाँदी अरु तामा"
  },
  {
   "n": "71",
   "text": "लौह चरण पर जब प्रभु आवैं"
  },
  {
   "n": "72",
   "text": "धन जन सम्पत्ति नष्ट करावैं"
  },
  {
   "n": "73",
   "text": "समता ताम्र रजत शुभकारी"
  },
  {
   "n": "74",
   "text": "स्वर्ण सर्व सुख मंगल भारी"
  },
  {
   "n": "75",
   "text": "जो यह शनि चरित्र नित गावै"
  },
  {
   "n": "76",
   "text": "कबहुं न दशा निकृष्ट सतावै"
  },
  {
   "n": "77",
   "text": "अद्भुत नाथ दिखावैं लीला"
  },
  {
   "n": "78",
   "text": "करैं शत्रु के नशि बलि ढीला"
  },
  {
   "n": "79",
   "text": "जो पण्डित सुयोग्य बुलवाई"
  },
  {
   "n": "80",
   "text": "विधिवत शनि ग्रह शांति कराई"
  },
  {
   "n": "81",
   "text": "पीपल जल शनि दिवस चढ़ावत"
  },
  {
   "n": "82",
   "text": "दीप दान दै बहु सुख पावत"
  },
  {
   "n": "83",
   "text": "कहत राम सुन्दर प्रभु दासा"
  },
  {
   "n": "84",
   "text": "शनि सुमिरत सुख होत प्रकाशा"
  },
  {
   "n": "85",
   "text": "पाठ शनिश्चर देव को, की हों भक्त तैयार"
  },
  {
   "n": "86",
   "text": "करत पाठ चालीस दिन, हो भवसागर पार"
  }
 ]
}