{
 "slug": "hanuman-ashtak",
 "verses": [
  {
   "n": "1",
   "text": "बाल समय रवि भक्षी लियो तब,"
  },
  {
   "n": "2",
   "text": "तीनहुं लोक भयो अँधियारो"
  },
  {
   "n": "3",
   "text": "ताहि सों त्रास भयो जग को,"
  },
  {
   "n": "4",
   "text": "यह संकट काहु सों जात न टारो"
  },
  {
   "n": "5",
   "text": "देवन आनि करी बिनती तब,"
  },
  {
   "n": "6",
   "text": "छाँड़ि दियो रवि कष्ट निवारो"
  },
  {
   "n": "7",
   "text": "को नहिं जानत है जग में कपि,"
  },
  {
   "n": "8",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "9",
   "text": "बालि की त्रास कपीस बसैं गिरि,"
  },
  {
   "n": "10",
   "text": "जात महाप्रभु पंथ निहारो"
  },
  {
   "n": "11",
   "text": "चौंकि महामुनि साप दियो तब,"
  },
  {
   "n": "12",
   "text": "चाहिए कौन बिचार बिचारो"
  },
  {
   "n": "13",
   "text": "कैद्विज रूप लिवाय महाप्रभु,"
  },
  {
   "n": "14",
   "text": "सो तुम दास के सोक निवारो"
  },
  {
   "n": "15",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "16",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "17",
   "text": "अंगद के संग लेन गए सिय,"
  },
  {
   "n": "18",
   "text": "खोज कपीस यह बैन उचारो"
  },
  {
   "n": "19",
   "text": "जीवत ना बचिहौ हम सो जु,"
  },
  {
   "n": "20",
   "text": "बिना सुधि लाये इहाँ पगु धारो"
  },
  {
   "n": "21",
   "text": "हेरी थके तट सिन्धु सबै तब,"
  },
  {
   "n": "22",
   "text": "लाए सिया-सुधि प्राण उबारो"
  },
  {
   "n": "23",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "24",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "25",
   "text": "रावण त्रास दई सिय को सब,"
  },
  {
   "n": "26",
   "text": "राक्षसी सों कही सोक निवारो"
  },
  {
   "n": "27",
   "text": "ताहि समय हनुमान महाप्रभु,"
  },
  {
   "n": "28",
   "text": "जाय महा रजनीचर मारो"
  },
  {
   "n": "29",
   "text": "चाहत सीय असोक सों आगि सु,"
  },
  {
   "n": "30",
   "text": "दै प्रभुमुद्रिका सोक निवारो"
  },
  {
   "n": "31",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "32",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "33",
   "text": "बान लग्यो उर लछिमन के तब,"
  },
  {
   "n": "34",
   "text": "प्राण तजे सुत रावन मारो"
  },
  {
   "n": "35",
   "text": "लै गृह बैद्य सुषेन समेत,"
  },
  {
   "n": "36",
   "text": "तबै गिरि द्रोण सु बीर उपारो"
  },
  {
   "n": "37",
   "text": "आनि सजीवन हाथ दई तब,"
  },
  {
   "n": "38",
   "text": "लछिमन के तुम प्रान उबारो"
  },
  {
   "n": "39",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "40",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "41",
   "text": "रावन जुध अजान कियो तब,"
  },
  {
   "n": "42",
   "text": "नाग कि फाँस सबै सिर डारो"
  },
  {
   "n": "43",
   "text": "श्रीरघुनाथ समेत सबै दल,"
  },
  {
   "n": "44",
   "text": "मोह भयो यह संकट भारो"
  },
  {
   "n": "45",
   "text": "आनि खगेस तबै हनुमान जु,"
  },
  {
   "n": "46",
   "text": "बंधन काटि सुत्रास निवारो"
  },
  {
   "n": "47",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "48",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "49",
   "text": "बंधु समेत जबै अहिरावन,"
  },
  {
   "n": "50",
   "text": "लै रघुनाथ पताल सिधारो"
  },
  {
   "n": "51",
   "text": "देबिहिं पूजि भलि विधि सों बलि,"
  },
  {
   "n": "52",
   "text": "देउ सबै मिलि मन्त्र विचारो"
  },
  {
   "n": "53",
   "text": "जाय सहाय भयो तब ही,"
  },
  {
   "n": "54",
   "text": "अहिरावन सैन्य समेत संहारो"
  },
  {
   "n": "55",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "56",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "57",
   "text": "काज किये बड़ देवन के तुम,"
  },
  {
   "n": "58",
   "text": "बीर महाप्रभु देखि बिचारो"
  },
  {
   "n": "59",
   "text": "कौन सो संकट मोर गरीब को,"
  },
  {
   "n": "60",
   "text": "जो तुमसे नहिं जात है टारो"
  },
  {
   "n": "61",
   "text": "बेगि हरो हनुमान महाप्रभु,"
  },
  {
   "n": "62",
   "text": "जो कछु संकट होय हमारो"
  },
  {
   "n": "63",
   "text": "को नहिं जानत है जग में कपि"
  },
  {
   "n": "64",
   "text": "संकटमोचन नाम तिहारो"
  },
  {
   "n": "65",
   "text": "लाल देह लाली लसे,"
  },
  {
   "n": "66",
   "text": "अरु धरि लाल लंगूर"
  },
  {
   "n": "67",
   "text": "वज्र देह दानव दलन,"
  },
  {
   "n": "68",
   "text": "जय जय जय कपि सूर"
  }
 ]
