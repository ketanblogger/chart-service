{
 "slug": "ram-raksha-stotra",
 "verses": [
  {
   "n": "1",
   "text": "ॐ श्रीगणेशाय नमः"
  },
  {
   "n": "2",
   "text": "अस्य श्रीरामरक्षास्तोत्रमन्त्रस्य"
  },
  {
   "n": "3",
   "text": "बुधकौशिकऋषिः"
  },
  {
   "n": "4",
   "text": "श्रीसीतारामचन्द्रो देवता"
  },
  {
   "n": "5",
   "text": "अनुष्टुप् छन्दः"
  },
  {
   "n": "6",
   "text": "सीता शक्तिः"
  },
  {
   "n": "7",
   "text": "श्रीमद्हनुमान् कीलकम्"
  },
  {
   "n": "8",
   "text": "श्रीसीतारामचंद्रप्रीत्यर्थे जपे विनियोगः"
  },
  {
   "n": "9",
   "text": "ध्यायेदाजानुबाहुं धृतशरधनुषं बद्धपद्मासनस्थं"
  },
  {
   "n": "10",
   "text": "पीतं वासो वसानं नवकमलदलस्पर्धिनेत्रं प्रसन्नम्"
  },
  {
   "n": "11",
   "text": "वामांकारूढसीता मुखकमलमिलल्लोचनं नीरदाभं"
  },
  {
   "n": "12",
   "text": "नानालंकारदीप्तं दधतमुरुजटामण्डलं रामचंद्रम्"
  },
  {
   "n": "13",
   "text": "इति ध्यानम्"
  },
  {
   "n": "14",
   "text": "चरितं रघुनाथस्य शतकोटिप्रविस्तरम्"
  },
  {
   "n": "15",
   "text": "एकैकमक्षरम् पुंसां महापातकनाशनम्"
  },
  {
   "n": "16",
   "text": "ध्यात्वा नीलोत्पलश्यामं रामं राजीवलोचनम्"
  },
  {
   "n": "17",
   "text": "जानकीलक्ष्मणोपेतं जटामुकुटमण्डितम्"
  },
  {
   "n": "18",
   "text": "सासितूणधनुर्बाणपाणिं नक्तंचरान्तकम्"
  },
  {
   "n": "19",
   "text": "स्वलीलया जगत्त्रातुमाविर्भूतमजं विभुम्"
  },
  {
   "n": "20",
   "text": "रामरक्षां पठेत्प्राज्ञः पापघ्नीं सर्वकामदाम्"
  },
  {
   "n": "21",
   "text": "शिरो मे राघवः पातु भालं दशरथात्मजः"
  },
  {
   "n": "22",
   "text": "कौसल्येयो दृशौ पातु विश्वामित्रप्रियः श्रुती"
  },
  {
   "n": "23",
   "text": "घ्राणं पातु मखत्राता मुखं सौमित्रिवत्सलः"
  },
  {
   "n": "24",
   "text": "जिह्वां विद्यानिधिः पातु कण्ठं भरतवंदितः"
  },
  {
   "n": "25",
   "text": "स्कन्धौ दिव्यायुधः पातु भुजौ भग्नेशकार्मुकः"
  },
  {
   "n": "26",
   "text": "करौ सीतापतिः पातु हृदयं जामदग्न्यजित्"
  },
  {
   "n": "27",
   "text": "मध्यं पातु खरध्वंसी नाभिं जाम्बवदाश्रयः"
  },
  {
   "n": "28",
   "text": "सुग्रीवेशः कटी पातु सक्थिनी हनुमत्प्रभुः"
  },
  {
   "n": "29",
   "text": "ऊरू रघूत्तमः पातु रक्षःकुलविनाशकृत्"
  },
  {
   "n": "30",
   "text": "जानुनी सेतुकृत्पातु जंघे दशमुखान्तकः"
  },
  {
   "n": "31",
   "text": "पादौ बिभीषणश्रीदः पातु रामोऽखिलं वपुः"
  },
  {
   "n": "32",
   "text": "एतां रामबलोपेतां रक्षां यः सुकृती पठेत्"
  },
  {
   "n": "33",
   "text": "स चिरायुः सुखी पुत्री विजयी विनयी भवेत्"
  },
  {
   "n": "34",
   "text": "पातालभूतलव्योमचारिणश्छद्मचारिणः"
  },
  {
   "n": "35",
   "text": "न द्रष्टुमपि शक्तास्ते रक्षितं रामनामभिः"
  },
  {
   "n": "36",
   "text": "रामेति रामभद्रेति रामचन्द्रेति वा स्मरन्"
  },
  {
   "n": "37",
   "text": "नरो न लिप्यते पापैर्भुक्तिं मुक्तिं च विन्दति"
  },
  {
   "n": "38",
   "text": "जगज्जैत्रैकमन्त्रेण रामनाम्नाभिरक्षितम्"
  },
  {
   "n": "39",
   "text": "यः कण्ठे धारयेत्तस्य करस्थाः सर्वसिद्धयः"
  },
  {
   "n": "40",
   "text": "वज्रपञ्जरनामेदं यो रामकवचं स्मरेत्"
  },
  {
   "n": "41",
   "text": "अव्याहताज्ञः सर्वत्र लभते जयमङ्गलम्"
  },
  {
   "n": "42",
   "text": "आदिष्टवान् यथा स्वप्ने रामरक्षामिमां हरः"
  },
  {
   "n": "43",
   "text": "तथा लिखितवान् प्रातः प्रबुद्धो बुधकौशिकः"
  },
  {
   "n": "44",
   "text": "आरामः कल्पवृक्षाणां विरामः सकलापदाम्"
  },
  {
   "n": "45",
   "text": "अभिरामस्त्रिलोकानां रामः श्रीमान् स नः प्रभुः"
  },
  {
   "n": "46",
   "text": "तरुणौ रूपसंपन्नौ सुकुमारौ महाबलौ"
  },
  {
   "n": "47",
   "text": "पुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ"
  },
  {
   "n": "48",
   "text": "फलमूलाशिनौ दान्तौ तापसौ ब्रह्मचारिणौ"
  },
  {
   "n": "49",
   "text": "पुत्रौ दशरथस्यैतौ भ्रातरौ रामलक्ष्मणौ"
  },
  {
   "n": "50",
   "text": "शरण्यौ सर्वसत्त्वानां श्रेष्ठौ सर्वधनुष्मताम्"
  },
  {
   "n": "51",
   "text": "रक्षः कुलनिहन्तारौ त्रायेतां नो रघूत्तमौ"
  },
  {
   "n": "52",
   "text": "आत्तसज्यधनुषाविषुस्पृशावक्षयाशुगनिषड्गसड्गिनौ"
  },
  {
   "n": "53",
   "text": "रक्षणाय मम रामलक्ष्मणावग्रतः पथि सदैव गच्छताम्"
  },
  {
   "n": "54",
   "text": "संनद्धः कवची खड्गी चापबाणधरो युवा"
  },
  {
   "n": "55",
   "text": "गच्छन्मनोरथोऽस्माकं रामः पातु सलक्ष्मणः"
  },
  {
   "n": "56",
   "text": "रामो दाशरथिः शूरो लक्ष्मणानुचरो बली"
  },
  {
   "n": "57",
   "text": "काकुत्स्थः पुरुषः पूर्णः कौसल्येयो रघूत्तमः"
  },
  {
   "n": "58",
   "text": "वेदान्तवेद्यो यज्ञेशः पुराणपुरुषोत्तमः"
  },
  {
   "n": "59",
   "text": "जानकीवल्लभः श्रीमानप्रमेयपराक्रमः"
  },
  {
   "n": "60",
   "text": "इत्येतानि जपेन्नित्यं मद्भक्तः श्रद्धयान्वितः"
  },
  {
   "n": "61",
   "text": "अश्वमेधाधिकं पुण्यं संप्राप्नोति न संशयः"
  },
  {
   "n": "62",
   "text": "रामं दूर्वादलश्यामं पद्माक्षं पीतवाससम्"
  },
  {
   "n": "63",
   "text": "स्तुवन्ति नामभिर्दिव्यैर्न ते संसारिणो नरः"
  },
  {
   "n": "64",
   "text": "रामं लक्ष्मणपूर्वजं रघुवरं सीतापतिं सुन्दरं"
  },
  {
   "n": "65",
   "text": "काकुत्स्थं करुणार्णवं गुणनिधिं विप्रप्रियं धार्मिकम्"
  },
  {
   "n": "66",
   "text": "राजेन्द्रं सत्यसंधं दशरथतनयं श्यामलं शान्तमूर्तिम्"
  },
  {
   "n": "67",
   "text": "वन्दे लोकाभिरामं रघुकुलतिलकं राघवं रावणारिम्"
  },
  {
   "n": "68",
   "text": "रामाय रामभद्राय रामचंद्राय वेधसे"
  },
  {
   "n": "69",
   "text": "रघुनाथाय नाथाय सीतायाः पतये नमः"
  },
  {
   "n": "70",
   "text": "श्रीराम राम रघुनन्दन राम राम"
  },
  {
   "n": "71",
   "text": "श्रीराम राम भरताग्रज राम राम"
  },
  {
   "n": "72",
   "text": "श्रीराम राम रणकर्कश राम राम"
  },
  {
   "n": "73",
   "text": "श्रीराम राम शरणं भव राम राम"
  },
  {
   "n": "74",
   "text": "श्रीरामचन्द्रचरणौ मनसा स्मरामि"
  },
  {
   "n": "75",
   "text": "श्रीरामचन्द्रचरणौ वचसा गृणामि"
  },
  {
   "n": "76",
   "text": "श्रीरामचन्द्रचरणौ शिरसा नमामि"
  },
  {
   "n": "77",
   "text": "श्रीरामचन्द्रचरणौ शरणं प्रपद्ये"
  },
  {
   "n": "78",
   "text": "माता रामो मत्पिता रामचन्द्रः"
  },
  {
   "n": "79",
   "text": "स्वामी रामो मत्सखा रामचंद्रः"
  },
  {
   "n": "80",
   "text": "सर्वस्वं मे रामचन्द्रो दयालुर्नान्यं जाने नैव जाने न जाने"
  },
  {
   "n": "81",
   "text": "दक्षिणे लक्ष्मणो यस्य वामे तु जनकात्मजा"
  },
  {
   "n": "82",
   "text": "पुरतो मारुतिर्यस्य तं वन्दे रघुनन्दनम्"
  },
  {
   "n": "83",
   "text": "लोकाभिरामं रणरङ्गधीरं राजीवनेत्रं रघुवंशनाथम्"
  },
  {
   "n": "84",
   "text": "कारुण्यरूपं करुणाकरं तं श्रीरामचन्द्रं शरणं प्रपद्ये"
  },
  {
   "n": "85",
   "text": "मनोजवं मारुततुल्यवेगं"
  },
  {
   "n": "86",
   "text": "जितेन्द्रियं बुद्धिमतां वरिष्ठम्"
  },
  {
   "n": "87",
   "text": "वातात्मजं वानरयूथमुख्यं"
  },
  {
   "n": "88",
   "text": "श्रीरामदूतं शरणं प्रपद्ये"
  },
  {
   "n": "89",
   "text": "कूजन्तं रामरामेति मधुरं मधुराक्षरम्"
  },
  {
   "n": "90",
   "text": "आरुह्य कविताशाखां वन्दे वाल्मीकिकोकिलम्"
  },
  {
   "n": "91",
   "text": "आपदामपहर्तारं दातारं सर्वसंपदाम्"
  },
  {
   "n": "92",
   "text": "लोकाभिरामं श्रीरामं भूयो भूयो नमाम्यहम्"
  },
  {
   "n": "93",
   "text": "भर्जनं भवबीजानामर्जनं सुखसंपदाम्"
  },
  {
   "n": "94",
   "text": "तर्जनं यमदूतानां रामरामेति गर्जनम्"
  },
  {
   "n": "95",
   "text": "रामो राजमणि सदा विजयते रामं रमेशं भजे"
  },
  {
   "n": "96",
   "text": "रामेणाभिहता निशाचरचमू रामाय तस्मै नमः"
  },
  {
   "n": "97",
   "text": "रामान्नास्ति परायणं परतरं रामस्य दासोऽस्म्यहम्"
  },
  {
   "n": "98",
   "text": "रामे चित्तलयः सदा भवतु मे भो राम मामुद्धर"
  },
  {
   "n": "99",
   "text": "राम रामेति रामेति रमे रामे मनोरमे"
  },
  {
   "n": "100",
   "text": "सहस्रनाम तत्तुल्यं रामनाम वरानने"
  },
  {
   "n": "101",
   "text": "इति श्रीबुधकौशिकविरचितं श्रीरामरक्षास्तोत्रं सम्पूर्णम्"
  }
 ]
}