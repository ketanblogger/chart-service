{
 "slug": "rudrashtakam",
 "verses": [
  {
   "n": "1",
   "text": "नमामीशमीशान निर्वाणरूपं"
  },
  {
   "n": "2",
   "text": "विभुं व्यापकं ब्रह्म वेदस्वरूपं"
  },
  {
   "n": "3",
   "text": "निजं निर्गुणं निर्विकल्पं निरीहं"
  },
  {
   "n": "4",
   "text": "चिदाकाशमाकाशवासं भजेहं"
  },
  {
   "n": "5",
   "text": "निराकारमोंकारमूलं तुरीयं"
  },
  {
   "n": "6",
   "text": "गिरा ज्ञान गोतीतमीशं गिरीशं"
  },
  {
   "n": "7",
   "text": "करालं महाकाल कालं कृपालं"
  },
  {
   "n": "8",
   "text": "गुणागार संसारपारं नतोहं"
  },
  {
   "n": "9",
   "text": "तुषाराद्रि संकाश गौरं गभीरं"
  },
  {
   "n": "10",
   "text": "मनोभूत कोटि प्रभा श्री शरीरं"
  },
  {
   "n": "11",
   "text": "स्फुरन्मौलि कल्लोलिनी चारु गंगा"
  },
  {
   "n": "12",
   "text": "लसद्भालबालेंदु कंठे भुजंगा"
  },
  {
   "n": "13",
   "text": "चलत्कुंडलं भ्रू सुनेत्रं विशालं"
  },
  {
   "n": "14",
   "text": "प्रसन्नाननं नीलकंठ दयालं"
  },
  {
   "n": "15",
   "text": "मृगाधीशचर्माम्बरं मुण्डमालं"
  },
  {
   "n": "16",
   "text": "प्रियं शंकरं सर्वनाथं भजामि"
  },
  {
   "n": "17",
   "text": "प्रचंडं प्रकृष्टं प्रगल्भं परेशं"
  },
  {
   "n": "18",
   "text": "अखंडं अजं भानुकोटिप्रकाशं"
  },
  {
   "n": "19",
   "text": "त्रयःशूल निर्मूलनं शूलपाणिं"
  },
  {
   "n": "20",
   "text": "भजेहं भवानीपतिं भावगम्यं"
  },
  {
   "n": "21",
   "text": "कलातीत कल्याण कल्पान्तकारी"
  },
  {
   "n": "22",
   "text": "सदा सज्जनानन्ददाता पुरारी"
  },
  {
   "n": "23",
   "text": "चिदानंदसंदोह मोहापहारी"
  },
  {
   "n": "24",
   "text": "प्रसीद प्रसीद प्रभो मन्मथारी"
  },
  {
   "n": "25",
   "text": "न यावद् उमानाथ पादारविन्दं"
  },
  {
   "n": "26",
   "text": "भजंतीह लोके परे वा नराणां"
  },
  {
   "n": "27",
   "text": "न तावत्सुखं शांति सन्तापनाशं"
  },
  {
   "n": "28",
   "text": "प्रसीद प्रभो सर्वभूताधिवासं"
  },
  {
   "n": "29",
   "text": "न जानामि योगं जपं नैव पूजां"
  },
  {
   "n": "30",
   "text": "नतोहं सदा सर्वदा शंभु तुभ्यं"
  },
  {
   "n": "31",
   "text": "जरा जन्म दुःखौघ तातप्यमानं"
  },
  {
   "n": "32",
   "text": "प्रभो पाहि आपन्नमामीश शंभो"
  },
  {
   "n": "33",
   "text": "रुद्राष्टकमिदं प्रोक्तं विप्रेण हरतोषये"
  },
  {
   "n": "34",
   "text": "ये पठन्ति नरा भक्त्या तेषां शम्भुः प्रसीदति"
  }
 ]
}