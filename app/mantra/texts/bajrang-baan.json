{
 "slug": "bajrang-baan",
 "verses": [
  {
   "n": "1",
   "text": "निश्चय प्रेम प्रतीति ते,"
  },
  {
   "n": "2",
   "text": "बिनय करैं सनमान"
  },
  {
   "n": "3",
   "text": "तेहि के कारज सकल शुभ,"
  },
  {
   "n": "4",
   "text": "सिद्ध करैं हनुमान"
  },
  {
   "n": "5",
   "text": "जय हनुमंत संत हितकारी,"
  },
  {
   "n": "6",
   "text": "सुन लीजै प्रभु विनय हमारी"
  },
  {
   "n": "7",
   "text": "जन के काज विलंब न कीजै,"
  },
  {
   "n": "8",
   "text": "आतुर दौरि महा सुख दीजै"
  },
  {
   "n": "9",
   "text": "जैसे कूदि सिंधु के पारा,"
  },
  {
   "n": "10",
   "text": "सुरसा बदन पैठि बिस्तारा"
  },
  {
   "n": "11",
   "text": "आगे जाय लंकिनी रोका,"
  },
  {
   "n": "12",
   "text": "मारेहु लात गई सुरलोका"
  },
  {
   "n": "13",
   "text": "जाय विभीषन को सुख दीन्हा,"
  },
  {
   "n": "14",
   "text": "सीता निरखि परमपद लीन्हा"
  },
  {
   "n": "15",
   "text": "बाग उजारि सिंधु महँ बोरा,"
  },
  {
   "n": "16",
   "text": "अति आतुर जमकातर तोरा"
  },
  {
   "n": "17",
   "text": "अक्षय कुमार मारि संहारा,"
  },
  {
   "n": "18",
   "text": "लूम लपेटि लंक को जारा"
  },
  {
   "n": "19",
   "text": "लाह समान लंक जरि गई"
  },
  {
   "n": "20",
   "text": "जय जय धुनि सुरपुर नभ भई"
  },
  {
   "n": "21",
   "text": "अब बिलंब केहि कारन स्वामी,"
  },
  {
   "n": "22",
   "text": "कृपा करहु उर अंतरयामी"
  },
  {
   "n": "23",
   "text": "जय जय लखन प्राण के दाता,"
  },
  {
   "n": "24",
   "text": "आतुर ह्वै दुख करहु निपाता"
  },
  {
   "n": "25",
   "text": "जय हनुमान जयति बलसागर,"
  },
  {
   "n": "26",
   "text": "सुर समूह समरथ भटनागर"
  },
  {
   "n": "27",
   "text": "ॐ हनु हनु हनु हनुमंत हठीले,"
  },
  {
   "n": "28",
   "text": "बैरिहि मारु बज्र की कीले"
  },
  {
   "n": "29",
   "text": "ॐ ह्रीं ह्रीं ह्रीं हनुमंत कपीसा"
  },
  {
   "n": "30",
   "text": "ॐ हुं हुं हुं हनु अरि उर सीसा"
  },
  {
   "n": "31",
   "text": "जय अंजनि कुमार बलवंता,"
  },
  {
   "n": "32",
   "text": "शंकर सुवन वीर हनुमंता"
  },
  {
   "n": "33",
   "text": "बदन कराल काल कुल घालक,"
  },
  {
   "n": "34",
   "text": "राम सहाय सदा प्रतिपालक"
  },
  {
   "n": "35",
   "text": "भूत प्रेत पिसाच निसाचर,"
  },
  {
   "n": "36",
   "text": "अगिनि बेताल काल मारी मर"
  },
  {
   "n": "37",
   "text": "इन्हें मारु तोहि सपथ राम की,"
  },
  {
   "n": "38",
   "text": "राखु नाथ मरजाद नाम की"
  },
  {
   "n": "39",
   "text": "सत्य होहु हरि सपथ पाइ कै"
  },
  {
   "n": "40",
   "text": "राम दूत धरु मारु धाइ कै"
  },
  {
   "n": "41",
   "text": "जय जय जय हनुमंत अगाधा,"
  },
  {
   "n": "42",
   "text": "दुःख पावत जन केहि अपराधा"
  },
  {
   "n": "43",
   "text": "पूजा जप तप नेम अचारा,"
  },
  {
   "n": "44",
   "text": "नहिँ जानत कछु दास तुम्हारा"
  },
  {
   "n": "45",
   "text": "बन उपबन मग गिरि गृह माहीं,"
  },
  {
   "n": "46",
   "text": "तुम्हरे बल हम डरपत नाहीं"
  },
  {
   "n": "47",
   "text": "जनकसुता हरि दास कहावौ,"
  },
  {
   "n": "48",
   "text": "ताकी सपथ विलंब न लावौ"
  },
  {
   "n": "49",
   "text": "जै जै जै धुनि होत अकासा,"
  },
  {
   "n": "50",
   "text": "सुमिरत होय दुसह दुख नासा"
  },
  {
   "n": "51",
   "text": "चरन पकरि कर जोरि मनावौँ,"
  },
  {
   "n": "52",
   "text": "यहि औसर अब केहि गोहरावौं"
  },
  {
   "n": "53",
   "text": "उठु उठु चलु तोहि राम दुहाई"
  },
  {
   "n": "54",
   "text": "पायँ परौं कर जोरि मनाई"
  },
  {
   "n": "55",
   "text": "ॐ चं चं चं चं चपल चलंता,"
  },
  {
   "n": "56",
   "text": "ॐ हनु हनु हनु हनु हनुमंता"
  },
  {
   "n": "57",
   "text": "ॐ हं हं हाँक देत कपि चंचल,"
  },
  {
   "n": "58",
   "text": "ॐ सं सं सहमि पराने खल दल"
  },
  {
   "n": "59",
   "text": "अपने जन को तुरत उबारौ,"
  },
  {
   "n": "60",
   "text": "सुमिरत होय आनंद हमारौ"
  },
  {
   "n": "61",
   "text": "यह बजरंग बाण जेहि मारै,"
  },
  {
   "n": "62",
   "text": "ताहि कहौ फिरि कवन उबारै"
  },
  {
   "n": "63",
   "text": "पाठ करै बजरंग बाण की,"
  },
  {
   "n": "64",
   "text": "हनुमत रक्षा करै प्रान की"
  },
  {
   "n": "65",
   "text": "यह बजरंग बाण जो जापै,"
  },
  {
   "n": "66",
   "text": "तासोँ भूत प्रेत सब कांपै"
  },
  {
   "n": "67",
   "text": "धूप देय जो जपै हमेसा,"
  },
  {
   "n": "68",
   "text": "ताके तन नहिँ रहै कलेसा"
  },
  {
   "n": "69",
   "text": "उर प्रतीति दृढ़, सरन ह्वै"
  },
  {
   "n": "70",
   "text": "पाठ करै धरि ध्यान"
  },
  {
   "n": "71",
   "text": "बाधा सब हर, करैं"
  },
  {
   "n": "72",
   "text": "सब काम सफल हनुमान"
  }
 ]
}