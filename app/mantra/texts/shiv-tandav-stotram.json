{
 "slug": "shiv-tandav-stotram",
 "verses": [
  {
   "n": "1",
   "text": "जटाऽटवीगलज्जलप्रवाहपावितस्थले गलेऽवलम्ब्य लम्बितां भुजङ्गतुङ्गमालिकाम्"
  },
  {
   "n": "2",
   "text": "डमड्डमड्डमड्डमन्निनादवड्डमर्वयं चकार चण्डताण्डवं तनोतु नः शिवः शिवम्"
  },
  {
   "n": "3",
   "text": "जटाकटाहसम्भ्रमभ्रमन्निलिम्पनिर्झरीविलोलवीचिवल्लरीविराजमानमूर्द्धनि"
  },
  {
   "n": "4",
   "text": "धगद्धगद्धगज्ज्वलल्ललाटपट्टपावके किशोरचन्द्रशेखरे रतिः प्रतिक्षणं मम"
  },
  {
   "n": "5",
   "text": "धराधरेन्द्रनन्दिनीविलासबन्धुबन्धुरस्फुरद्दिगन्तसन्ततिप्रमोदमानमानसे"
  },
  {
   "n": "6",
   "text": "कृपाकटाक्षधोरणीनिरुद्धदुर्धरापदि क्वचिद्दिगम्बरे मनो विनोदमेतु वस्तुनि"
  },
  {
   "n": "7",
   "text": "जटाभुजङ्गपिङ्गलस्फुरत्फणामणिप्रभाकदम्बकुङ्कुमद्रवप्रलिप्तदिग्वधूमुखे"
  },
  {
   "n": "8",
   "text": "मदान्धसिन्धुरस्फुरत्त्वगुत्तरीयमेदुरे मनो विनोदमद्भुतं बिभर्तु भूतभर्तरि"
  },
  {
   "n": "9",
   "text": "सहस्रलोचनप्रभृत्यशेषलेखशेखरप्रसूनधूलिधोरणीविधूसराङ्घ्रिपीठभूः"
  },
  {
   "n": "10",
   "text": "भुजङ्गराजमालया निबद्धजाटजूटकः श्रियै चिराय जायतां चकोरबन्धुशेखरः"
  },
  {
   "n": "11",
   "text": "ललाटचत्वरज्वलद्धनञ्जयस्फुलिङ्गभानिपीतपञ्चसायकं नमन्निलिम्पनायकम्"
  },
  {
   "n": "12",
   "text": "सुधामयूखलेखया विराजमानशेखरं महाकपालिसम्पदेशिरोजटालमस्तु नः"
  },
  {
   "n": "13",
   "text": "करालभालपट्टिकाधगद्धगद्धगज्ज्वलद्धनञ्जयाहुतीकृतप्रचण्डपञ्चसायके"
  },
  {
   "n": "14",
   "text": "धराधरेन्द्रनन्दिनीकुचाग्रचित्रपत्रकप्रकल्पनैकशिल्पिनि त्रिलोचने रतिर्मम"
  },
  {
   "n": "15",
   "text": "नवीनमेघमण्डलीनिरुद्धदुर्धरस्फुरत्कुहूनिशीथिनीतमःप्रबन्धबद्धकन्धरः"
  },
  {
   "n": "16",
   "text": "निलिम्पनिर्झरीधरस्तनोतु कृत्तिसिन्धुरः कलानिधानबन्धुरः श्रियं जगद्धुरन्धरः"
  },
  {
   "n": "17",
   "text": "प्रफुल्लनीलपङ्कजप्रपञ्चकालिमप्रभाऽवलम्बिकण्ठकन्दलीरुचिप्रबद्धकन्धरम्"
  },
  {
   "n": "18",
   "text": "स्मरच्छिदं पुरच्छिदं भवच्छिदं मखच्छिदं गजच्छिदान्धकच्छिदं तमन्तकच्छिदं भजे"
  },
  {
   "n": "19",
   "text": "अखर्वसर्वमङ्गलाकलाकदम्बमञ्जरीरसप्रवाहमाधुरीविजृम्भणामधुव्रतम्"
  },
  {
   "n": "20",
   "text": "स्मरान्तकं पुरान्तकं भवान्तकं मखान्तकं गजान्तकान्धकान्तकं तमन्तकान्तकं भजे"
  },
  {
   "n": "21",
   "text": "जयत्वदभ्रविभ्रमभ्रमद्भुजङ्गमश्वसद्विनिर्गमत्क्रमस्फुरत्करालभालहव्यवाट्"
  },
  {
   "n": "22",
   "text": "धिमिद्धिमिद्धिमिद्ध्वनन्मृदङ्गतुङ्गमङ्गलध्वनिक्रमप्रवर्तितप्रचण्डताण्डवः शिवः"
  },
  {
   "n": "23",
   "text": "दृषद्विचित्रतल्पयोर्भुजङ्गमौक्तिकस्रजोर्गरिष्ठरत्नलोष्ठयोः सुहृद्विपक्षपक्षयोः"
  },
  {
   "n": "24",
   "text": "तृणारविन्दचक्षुषोः प्रजामहीमहेन्द्रयोः समप्रवृत्तिकः कदा सदाशिवं भजाम्यहम्"
  },
  {
   "n": "25",
   "text": "कदा निलिम्पनिर्झरीनिकुञ्जकोटरे वसन् विमुक्तदुर्मतिः सदा शिरःस्थमञ्जलिं वहन्"
  },
  {
   "n": "26",
   "text": "विमुक्तलोललोचनो ललामभाललग्नकः शिवेति मन्त्रमुच्चरन्कदा सुखी भवाम्यहम्"
  },
  {
   "n": "27",
   "text": "निलिम्पनाथनागरीकदम्बमौलमल्लिकानिगुम्फनिर्भरक्षरन्मधूष्णिकामनोहरः"
  },
  {
   "n": "28",
   "text": "तनोतु नो मनोमुदं विनोदिनीमहर्निशं परश्रियः परं पदं तदङ्गजत्विषां चयः"
  },
  {
   "n": "29",
   "text": "प्रचण्डवाडवानलप्रभाशुभप्रचारणी महाष्टसिद्धिकामिनीजनाऽवहूतजल्पना"
  },
  {
   "n": "30",
   "text": "विमुक्तवामलोचनाविवाहकालिकध्वनिः शिवेति मन्त्रभूषणा जगज्जयाय जायताम्"
  },
  {
   "n": "31",
   "text": "इमं हि नित्यमेवमुक्तमुत्तमोत्तमं स्तवं पठन्स्मरन्ब्रुवन्नरो विशुद्धिमेतिसन्ततम्"
  },
  {
   "n": "32",
   "text": "हरे गुरौ सुभक्तिमाशु याति नाऽन्यथा गतिं विमोहनं हि देहिनां सुशङ्करस्य चिन्तनम्"
  },
  {
   "n": "33",
   "text": "पूजावसानसमये दशवक्त्रगीतं यः शम्भुपूजनपरं पठति प्रदोषे"
  },
  {
   "n": "34",
   "text": "तस्य स्थिरां रथगजेन्द्रतुरङ्गयुक्तां लक्ष्मीं सदैव सुमुखीं प्रददाति शम्भुः"
  },
  {
   "n": "35",
   "text": "इति श्रीरावणकृतं शिवताण्डवस्तोत्रं सम्पूर्णम्"
  }
 ]
}