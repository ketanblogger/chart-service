{
 "slug": "jai-ambe-gauri",
 "verses": [
  {
   "n": "1",
   "text": "जय अम्बे गौरी,"
  },
  {
   "n": "2",
   "text": "मैया जय श्यामा गौरी"
  },
  {
   "n": "3",
   "text": "तुमको निशदिन ध्यावत,"
  },
  {
   "n": "4",
   "text": "हरि ब्रह्मा शिवरी"
  },
  {
   "n": "5",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "6",
   "text": "मांग सिंदूर विराजत,"
  },
  {
   "n": "7",
   "text": "टीको मृगमद को"
  },
  {
   "n": "8",
   "text": "उज्ज्वल से दोउ नैना,"
  },
  {
   "n": "9",
   "text": "चंद्रवदन नीको"
  },
  {
   "n": "10",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "11",
   "text": "कनक समान कलेवर,"
  },
  {
   "n": "12",
   "text": "रक्ताम्बर राजै"
  },
  {
   "n": "13",
   "text": "रक्तपुष्प गल माला,"
  },
  {
   "n": "14",
   "text": "कंठन पर साजै"
  },
  {
   "n": "15",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "16",
   "text": "केहरि वाहन राजत,"
  },
  {
   "n": "17",
   "text": "खड्ग खप्पर धारी"
  },
  {
   "n": "18",
   "text": "सुर-नर-मुनिजन सेवत,"
  },
  {
   "n": "19",
   "text": "तिनके दुखहारी"
  },
  {
   "n": "20",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "21",
   "text": "कानन कुण्डल शोभित,"
  },
  {
   "n": "22",
   "text": "नासाग्रे मोती"
  },
  {
   "n": "23",
   "text": "कोटिक चंद्र दिवाकर,"
  },
  {
   "n": "24",
   "text": "सम राजत ज्योती"
  },
  {
   "n": "25",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "26",
   "text": "शुंभ-निशुंभ बिदारे,"
  },
  {
   "n": "27",
   "text": "महिषासुर घाती"
  },
  {
   "n": "28",
   "text": "धूम्र विलोचन नैना,"
  },
  {
   "n": "29",
   "text": "निशदिन मदमाती"
  },
  {
   "n": "30",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "31",
   "text": "चण्ड-मुण्ड संहारे,"
  },
  {
   "n": "32",
   "text": "शोणित बीज हरे"
  },
  {
   "n": "33",
   "text": "मधु-कैटभ दोउ मारे,"
  },
  {
   "n": "34",
   "text": "सुर भयहीन करे"
  },
  {
   "n": "35",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "36",
   "text": "ब्रह्माणी, रुद्राणी,"
  },
  {
   "n": "37",
   "text": "तुम कमला रानी"
  },
  {
   "n": "38",
   "text": "आगम निगम बखानी,"
  },
  {
   "n": "39",
   "text": "तुम शिव पटरानी"
  },
  {
   "n": "40",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "41",
   "text": "चौंसठ योगिनी मंगल गावत,"
  },
  {
   "n": "42",
   "text": "नृत्य करत भैरों"
  },
  {
   "n": "43",
   "text": "बाजत ताल मृदंगा,"
  },
  {
   "n": "44",
   "text": "अरु बाजत डमरू"
  },
  {
   "n": "45",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "46",
   "text": "तुम ही जग की माता,"
  },
  {
   "n": "47",
   "text": "तुम ही हो भरता,"
  },
  {
   "n": "48",
   "text": "भक्तन की दुख हरता"
  },
  {
   "n": "49",
   "text": "सुख संपति करता"
  },
  {
   "n": "50",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "51",
   "text": "भुजा चार अति शोभित,"
  },
  {
   "n": "52",
   "text": "वर मुद्रा धारी"
  },
  {
   "n": "53",
   "text": "मनवांछित फल पावत,"
  },
  {
   "n": "54",
   "text": "सेवत नर नारी"
  },
  {
   "n": "55",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "56",
   "text": "कंचन थाल विराजत,"
  },
  {
   "n": "57",
   "text": "अगर कपूर बाती"
  },
  {
   "n": "58",
   "text": "श्रीमालकेतु में राजत,"
  },
  {
   "n": "59",
   "text": "कोटि रतन ज्योती"
  },
  {
   "n": "60",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "61",
   "text": "श्री अंबेजी की आरती, जो कोई नर गावे"
  },
  {
   "n": "62",
   "text": "कहत शिवानंद स्वामी,"
  },
  {
   "n": "63",
   "text": "सुख-संपति पावे"
  },
  {
   "n": "64",
   "text": "ॐ जय अम्बे गौरी.."
  },
  {
   "n": "65",
   "text": "जय अम्बे गौरी,"
  },
  {
   "n": "66",
   "text": "मैया जय श्यामा गौरी"
  }
 ]
