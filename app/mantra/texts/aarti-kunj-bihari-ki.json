 "verses": [
  {
   "n": "1",
   "text": "आरती कुंजबिहारी की,"
  },
  {
   "n": "2",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "3",
   "text": "आरती कुंजबिहारी की,"
  },
  {
   "n": "4",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "5",
   "text": "गले में बैजंती माला,"
  },
  {
   "n": "6",
   "text": "बजावै मुरली मधुर बाला"
  },
  {
   "n": "7",
   "text": "श्रवण में कुण्डल झलकाला,"
  },
  {
   "n": "8",
   "text": "नंद के आनंद नंदलाला"
  },
  {
   "n": "9",
   "text": "गगन सम अंग कांति काली,"
  },
  {
   "n": "10",
   "text": "राधिका चमक रही आली"
  },
  {
   "n": "11",
   "text": "लतन में ठाढ़े बनमाली"
  },
  {
   "n": "12",
   "text": "भ्रमर सी अलक,"
  },
  {
   "n": "13",
   "text": "कस्तूरी तिलक,"
  },
  {
   "n": "14",
   "text": "चंद्र सी झलक,"
  },
  {
   "n": "15",
   "text": "ललित छवि श्यामा प्यारी की,"
  },
  {
   "n": "16",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "17",
   "text": "आरती कुंजबिहारी की,"
  },
  {
   "n": "18",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "19",
   "text": "कनकमय मोर मुकुट बिलसै,"
  },
  {
   "n": "20",
   "text": "देवता दरसन को तरसै"
  },
  {
   "n": "21",
   "text": "गगन सों सुमन रासि बरसै"
  },
  {
   "n": "22",
   "text": "बजे मुरचंग, मधुर मिरदंग, ग्वालिन संग"
  },
  {
   "n": "23",
   "text": "अतुल रति गोप कुमारी की,"
  },
  {
   "n": "24",
   "text": "श्री गिरिधर कृष्णमुरारी की"
  },
  {
   "n": "25",
   "text": "आरती कुंजबिहारी की,"
  },
  {
   "n": "26",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "27",
   "text": "जहां ते प्रकट भई गंगा,"
  },
  {
   "n": "28",
   "text": "कलिमल हारिणि श्रीगंगा"
  },
  {
   "n": "29",
   "text": "स्मरन ते होत मोह भंगा"
  },
  {
   "n": "30",
   "text": "बसी शिव सीस, जटा के बीच, हरै अघ कीच"
  },
  {
   "n": "31",
   "text": "चरन छवि श्रीबनवारी की,"
  },
  {
   "n": "32",
   "text": "श्री गिरिधर कृष्णमुरारी की"
  },
  {
   "n": "33",
   "text": "आरती कुंजबिहारी की,"
  },
  {
   "n": "34",
   "text": "श्री गिरिधर कृष्ण मुरारी की"
  },
  {
   "n": "35",
   "text": "चमकती उज्ज्वल तट रेनू,"
