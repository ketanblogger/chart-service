{
 "slug": "lingashtakam",
 "verses": [
  {
   "n": "1",
   "text": "ब्रह्ममुरारिसुरार्चितलिङ्गं"
  },
  {
   "n": "2",
   "text": "निर्मल भासित शोभित लिङ्गं"
  },
  {
   "n": "3",
   "text": "जन्मज दुःख विनाशक लिङ्गं"
  },
  {
   "n": "4",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "5",
   "text": "देवमुनिप्रवरार्चितलिङ्गं"
  },
  {
   "n": "6",
   "text": "कामदहन करुणाकर लिङ्गं"
  },
  {
   "n": "7",
   "text": "रावण दर्प विनाशक लिङ्गं"
  },
  {
   "n": "8",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "9",
   "text": "सर्व सुगन्ध सुलेपित लिङ्गं"
  },
  {
   "n": "10",
   "text": "बुद्धिविवर्धनकारणलिङ्गं"
  },
  {
   "n": "11",
   "text": "सिद्ध सुरासुर वंदित लिङ्गं"
  },
  {
   "n": "12",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "13",
   "text": "कनक महामणि भूषित लिङ्गं"
  },
  {
   "n": "14",
   "text": "फणिपति वेष्टित शोभित लिङ्गं"
  },
  {
   "n": "15",
   "text": "दक्ष सुयज्ञ विनाशन लिङ्गं"
  },
  {
   "n": "16",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "17",
   "text": "कुङ्कुमचन्दनलेपितलिङ्गं"
  },
  {
   "n": "18",
   "text": "पंकज हार सुशोभित लिङ्गं"
  },
  {
   "n": "19",
   "text": "संचित पाप विनाशक लिङ्गं"
  },
  {
   "n": "20",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "21",
   "text": "देवगणार्चितसेवितलिङ्गं"
  },
  {
   "n": "22",
   "text": "भावै-र्भक्तिभिरेव च लिङ्गं"
  },
  {
   "n": "23",
   "text": "दिनकरकोटिप्रभाकरलिङ्गं"
  },
  {
   "n": "24",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "25",
   "text": "अष्टदलोपरिवेष्टितलिङ्गं"
  },
  {
   "n": "26",
   "text": "सर्वसमुद्भव कारण लिङ्गं"
  },
  {
   "n": "27",
   "text": "अष्टदरिद्र विनाशन लिङ्गं"
  },
  {
   "n": "28",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "29",
   "text": "सुरगुरु सुरवर पूजित लिङ्गं"
  },
  {
   "n": "30",
   "text": "सुरवन पुष्प सदार्चित लिङ्गं"
  },
  {
   "n": "31",
   "text": "परात्परं परमात्मकलिङ्गं"
  },
  {
   "n": "32",
   "text": "तत् प्रणमामि सदाशिव लिङ्गं"
  },
  {
   "n": "33",
   "text": "लिङ्गाष्टकमिदं पुण्यं यः पठेच्छिवसन्निधौ"
  },
  {
   "n": "34",
   "text": "शिवलोकमवाप्नोति शिवेन सह मोदते"
  }
 ]
}